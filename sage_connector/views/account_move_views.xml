<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sage_export" model="ir.ui.view">
        <field name="name">account.move.form.sage.export</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_to_sage_connector"
                        type="object"
                        string="Export to Sage"
                        class="btn-primary"
                        icon="fa-exchange"
                        invisible="state != 'posted' or move_type not in ('out_invoice','out_refund')"
                        groups="sage_connector.group_sage_user"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <label for="sage_doc_no" string="Sage Doc No." invisible="move_type not in ('out_invoice','out_refund')"/>
                <field name="sage_doc_no"
                       readonly="1"
                       invisible="move_type not in ('out_invoice','out_refund')"
                       placeholder="Not exported yet"/>
            </xpath>
        </field>
    </record>
</odoo>
