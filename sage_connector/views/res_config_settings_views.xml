<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_sage_connector" model="ir.ui.view">
        <field name="name">res.config.settings.sage.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Sage Connector" name="sage_connector_settings">
                    <setting string="Sage 50 Pastel backend"
                             help="URL, API key, and adapter live on Sage Connector → Backends. Tax and journal mappings are configured there. Duplicate Pastel Bridge URL/key settings are not used.">
                        <div class="content-group">
                            <button name="%(sage_connector.action_sage_backend)d"
                                    type="action"
                                    string="Open Sage Backends"
                                    class="btn-link"
                                    groups="sage_connector.group_sage_manager"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
