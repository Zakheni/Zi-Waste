<odoo>
    <record id="view_users_form_inherit_theme" model="ir.ui.view">
        <field name="name">res.users.form.inherit.theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Theme">
                    <group>
                        <field name="theme_color" placeholder="#RRGGBB"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
