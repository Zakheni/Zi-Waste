<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_export_history_form" model="ir.ui.view">
        <field name="name">batch.payment.export.history.form</field>
        <field name="model">batch.payment.export.history</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="batch_id"/>
                    <field name="export_date"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <field name="sage_reference"/>
                </group>
                <group>
                    <field name="request_payload" widget="text"/>
                    <field name="response_payload" widget="text"/>
                </group>
            </form>
        </field>
    </record>
</odoo>