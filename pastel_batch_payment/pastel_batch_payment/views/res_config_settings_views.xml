<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_pastel_batch" model="ir.ui.view">
        <field name="name">res.config.settings.pastel.batch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Batch Payments" name="pastel_batch_payment_settings">
                    <setting string="Sage export"
                             help="Batch payment export uses Sage Connector. Duplicate Pastel Bridge URL/API key settings have been removed.">
                        <div class="content-group">
                            <button name="%(sage_connector.action_sage_backend)d"
                                    type="action"
                                    string="Configure Sage Backend"
                                    class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
