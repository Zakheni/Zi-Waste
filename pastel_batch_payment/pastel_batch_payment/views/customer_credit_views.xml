<?xml version="1.0" encoding="utf-8"?>

<!--
    Module: pastel_batch_payment
    File: customer_credit_views.xml
    Description: Customer credit ledger views.
-->
<odoo>

    <!-- Tree View -->
    <!-- View/action record: View customer credit tree -->
    <record id="view_customer_credit_tree" model="ir.ui.view">
        <field name="name">customer.credit.tree</field>
        <field name="model">customer.credit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="batch_id"/>
                <field name="amount"/>
                <field name="balance"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <!-- View/action record: View customer credit form -->
    <record id="view_customer_credit_form" model="ir.ui.view">
        <field name="name">customer.credit.form</field>
        <field name="model">customer.credit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="batch_id"/>
                            <field name="state"/>
                        </group>

                        <group>
                            <field name="amount"/>
                            <field name="balance"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Usage History">

                            <field name="usage_ids">

                                <tree create="0" edit="0" delete="0">

                                    <field name="create_date"/>

                                    <field name="source_batch_id"/>

                                    <field name="applied_batch_id"/>

                                    <field name="amount"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Total Used"/>

                                    <field name="currency_id" optional="hide"
                                           invisible="1"/>

                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                                    <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>

                                </tree>

                            </field>

                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Action -->
    <!-- View/action record: Action customer credit -->
    <record id="action_customer_credit" model="ir.actions.act_window">
        <field name="name">Customer Credits</field>
        <field name="res_model">customer.credit</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>