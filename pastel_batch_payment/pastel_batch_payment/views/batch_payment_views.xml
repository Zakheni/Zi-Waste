<?xml version="1.0" encoding="utf-8"?>

<!--
    Module: pastel_batch_payment
    File: batch_payment_views.xml
    Description: Batch payment tree, form, search, and action.
-->
<odoo>

    <!-- ===================== -->
    <!-- SEARCH VIEW -->
    <!-- ===================== -->
    <record id="view_batch_payment_search" model="ir.ui.view">
        <field name="name">batch.payment.search</field>
        <field name="model">batch.payment</field>
        <field name="arch" type="xml">
            <search string="Batch Payments">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="exported_ref"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Validated" name="validated" domain="[('state','=','validated')]"/>
                <filter string="Exported" name="exported" domain="[('state','=','exported')]"/>
                <filter string="Partial Paid" name="partial" domain="[('state','=','partial')]"/>
                <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Customer" name="customer" domain="[('partner_type','=','customer')]"/>
                <filter string="Supplier" name="supplier" domain="[('partner_type','=','supplier')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Journal" name="group_journal" context="{'group_by':'journal_id'}"/>
                    <filter string="Partner Type" name="group_partner_type" context="{'group_by':'partner_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== -->
    <!-- TREE VIEW -->
    <!-- ===================== -->
    <record id="view_batch_payment_tree" model="ir.ui.view">
        <field name="name">batch.payment.tree</field>
        <field name="model">batch.payment</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ('validated', 'partial')"
                  decoration-success="state in ('exported', 'paid')">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_type"/>
                <field name="partner_id" optional="show"/>
                <field name="journal_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="amount_received" widget="monetary" optional="show" sum="Received"/>
                <field name="exported_ref" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('validated', 'partial')"
                       decoration-success="state in ('exported', 'paid')"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ===================== -->
    <!-- FORM VIEW -->
    <!-- ===================== -->
    <record id="view_batch_payment_form" model="ir.ui.view">
        <field name="name">batch.payment.form</field>
        <field name="model">batch.payment</field>
        <field name="arch" type="xml">
            <form string="Batch Payment" class="o_batch_payment_form">
                <header>
                    <button name="action_validate"
                            type="object"
                            string="Validate"
                            groups="pastel_batch_payment.group_finance_clerk,pastel_batch_payment.group_finance_manager"
                            invisible="state != 'draft'"
                            class="oe_highlight btn-primary"/>
                    <button name="action_open_receive_payment"
                            type="object"
                            string="Receive Payment"
                            groups="pastel_batch_payment.group_finance_clerk,pastel_batch_payment.group_finance_manager"
                            invisible="sage_exported or state not in ('validated', 'partial')"
                            class="oe_highlight btn-primary"/>
                    <button name="action_export_sage"
                            type="object"
                            string="Export to Sage"
                            groups="pastel_batch_payment.group_finance_clerk,pastel_batch_payment.group_finance_manager"
                            invisible="sage_exported or state not in ('validated', 'partial', 'paid')"
                            class="btn-secondary"/>
                    <button name="action_set_to_draft"
                            type="object"
                            string="Set to Draft"
                            groups="pastel_batch_payment.group_finance_clerk,pastel_batch_payment.group_finance_manager"
                            invisible="state not in ('validated', 'exported', 'cancelled')"
                            class="btn-secondary"
                            confirm="Reset this batch to draft? Sage export reference will be cleared."/>
                    <button name="%(action_batch_payment_statement)d"
                            type="action"
                            string="Print Statement"
                            class="btn-secondary"
                            invisible="state not in ('partial','paid')"/>
                    <button name="action_load_open_items"
                            type="object"
                            string="Load Open Items"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel"
                            string="Cancel Batch"
                            type="object"
                            class="btn-link text-danger"
                            invisible="state in ('draft','cancelled','paid','exported') or sage_exported"
                            confirm="Credit allocations will be restored. Continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,validated,exported,partial,paid"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="sage_exported" invisible="1"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success"
                            invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="Exported" bg_color="text-bg-info"
                            invisible="state != 'exported'"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-list" disabled="1">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-money" disabled="1">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="amount_total" widget="monetary"/>
                                </span>
                                <span class="o_stat_text">Batch Total</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-cloud-upload" disabled="1"
                                invisible="not sage_exported">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="exported_ref"/>
                                </span>
                                <span class="o_stat_text">Sage Ref</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1" placeholder="New Batch"/>
                        </h1>
                    </div>

                    <div class="alert alert-info o_batch_payment_hint mb-3" role="status"
                         invisible="not next_step_hint">
                        <field name="next_step_hint" nolabel="1" readonly="1"
                               class="o_batch_payment_hint_text"/>
                    </div>

                    <group>
                        <group string="Batch details">
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="partner_type" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id" string="Customer"
                                   invisible="partner_type != 'customer'"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id" string="Supplier"
                                   invisible="partner_type != 'supplier'"
                                   domain="[('supplier_rank','>',0)]"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Payment method">
                            <field name="journal_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="payment_method_line_id"
                                   domain="[('journal_id','=',journal_id)]"
                                   context="{'default_journal_id': journal_id}"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="exported_ref" readonly="1"
                                   invisible="not exported_ref"/>
                        </group>
                    </group>

                    <group string="Customer Credit" class="o_batch_payment_credit"
                           invisible="credit_balance_before == 0">
                        <group>
                            <field name="credit_balance_before" readonly="1"/>
                            <field name="credit_applied" readonly="1"/>
                        </group>
                        <group>
                            <field name="credit_balance_after" readonly="1"/>
                            <field name="amount_due_after_credit" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lines" name="lines">
                            <div class="o_batch_payment_line_actions mb-2"
                                 invisible="state != 'draft'">
                                <button name="%(action_batch_payment_add_wizard)d"
                                        type="action"
                                        string="Select Posted Payments"
                                        class="btn-primary"
                                        context="{
                                            'default_batch_id': active_id,
                                            'bp_company_id': company_id,
                                            'bp_journal_id': journal_id,
                                            'bp_pml_id': payment_method_line_id,
                                            'bp_partner_id': partner_id
                                        }"/>
                                <button name="action_load_outstanding_invoices"
                                        type="object"
                                        string="Load Outstanding Invoices"
                                        class="btn-secondary"/>
                            </div>
                            <field name="line_ids"
                                   context="{
                                       'default_batch_id': active_id,
                                       'bp_company_id': company_id,
                                       'bp_journal_id': journal_id,
                                       'bp_pml_id': payment_method_line_id,
                                       'bp_partner_id': partner_id
                                   }"
                                   readonly="state != 'draft'">
                                <tree editable="bottom"
                                      decoration-muted="status != 'posted'">
                                    <field name="payment_id"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[
                                               ('state', '=', 'posted'),
                                               ('company_id', '=', context.get('bp_company_id')),
                                               ('in_exported_batch', '=', False),
                                               ('batch_invoice_id', '!=', False),
                                               ('batch_invoice_id.batch_payment_state', '=', 'not_paid'),
                                               '|', ('journal_id', '=', context.get('bp_journal_id')),
                                                    ('journal_id', '!=', False),
                                               '|', ('payment_method_line_id', '=', context.get('bp_pml_id')),
                                                    ('payment_method_line_id', '!=', False),
                                               '|', '&amp;',
                                                    ('partner_id', '=', context.get('bp_partner_id')),
                                                    ('partner_id', '!=', False),
                                                    ('partner_id', '=', False)
                                           ]"/>
                                    <field name="move_id"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="journal_id" optional="hide"/>
                                    <field name="payment_method_line_id" optional="hide"/>
                                    <field name="source_batch_id" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'posted'"/>
                                    <field name="communication" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer o_batch_payment_totals" colspan="2">
                                <field name="amount_due" readonly="1"/>
                                <field name="amount_received" readonly="1"/>
                                <field name="payment_difference" readonly="1"
                                       decoration-danger="payment_difference != 0"
                                       decoration-success="payment_difference == 0"/>
                            </group>
                        </page>
                        <page string="Export History" name="export_history">
                            <field name="export_history_ids" readonly="1">
                                <tree decoration-success="state == 'success'"
                                      decoration-danger="state == 'failed'"
                                      default_order="export_date desc">
                                    <field name="export_date"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'success'"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="sage_reference"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===================== -->
    <!-- KANBAN VIEW -->
    <!-- ===================== -->
    <record id="view_batch_payment_kanban" model="ir.ui.view">
        <field name="name">batch.payment.kanban</field>
        <field name="model">batch.payment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_batch_payment_kanban"
                    sample="1"
                    group_create="0"
                    records_draggable="0"
                    quick_create="0">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="partner_type"/>
                <field name="journal_id"/>
                <field name="amount_total"/>
                <field name="amount_received"/>
                <field name="currency_id"/>
                <field name="exported_ref"/>
                <field name="line_count"/>
                <field name="sage_exported"/>
                <field name="state"/>
                <field name="activity_ids"/>
                <progressbar field="state"
                             colors='{"draft": "muted", "validated": "warning", "exported": "info", "partial": "warning", "paid": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card o_batch_payment_kanban_card o_batch_payment_state_#{record.state.raw_value}">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                            <div class="o_batch_payment_kanban_body">
                                <div class="o_batch_payment_kanban_row" t-if="record.partner_id.value">
                                    <i class="fa fa-user me-1" title="Partner"/>
                                    <field name="partner_id"/>
                                </div>
                                <div class="o_batch_payment_kanban_row text-muted">
                                    <i class="fa fa-calendar me-1" title="Date"/>
                                    <field name="payment_date"/>
                                    <span class="mx-1">·</span>
                                    <field name="journal_id"/>
                                </div>
                                <div class="o_batch_payment_kanban_row mt-2 d-flex justify-content-between align-items-center">
                                    <span>
                                        <field name="amount_total" widget="monetary"/>
                                    </span>
                                    <span class="badge text-bg-light" t-if="record.line_count.raw_value">
                                        <t t-esc="record.line_count.value"/> lines
                                    </span>
                                </div>
                                <div class="o_batch_payment_kanban_row mt-1" t-if="record.exported_ref.value">
                                    <i class="fa fa-cloud-upload me-1" title="Sage"/>
                                    <span class="text-muted">Sage:</span>
                                    <field name="exported_ref"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="partner_type" widget="badge"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {
                                               'draft': 'secondary',
                                               'validated': 'warning',
                                               'exported': 'info',
                                               'partial': 'warning',
                                               'paid': 'success',
                                               'cancelled': 'danger'
                                           }}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== -->
    <!-- ACTION -->
    <!-- ===================== -->
    <record id="action_batch_payment" model="ir.actions.act_window">
        <field name="name">Batch Payments</field>
        <field name="res_model">batch.payment</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_batch_payment_search"/>
        <field name="context">{'default_group_by': 'state'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Batch Payment
            </p>
            <p>
                Group posted payments and open invoices, then validate and export to Sage Pastel.
            </p>
        </field>
    </record>

</odoo>
