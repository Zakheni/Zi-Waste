<?xml version="1.0" encoding="utf-8"?>

<!--
    Module: pastel_batch_payment
    File: batch_payment_receive_wizard_view.xml
    Description: Wizard to record received batch payment amounts.
-->
<odoo>

    <!-- View/action record: View batch payment receive wizard -->

    <record id="view_batch_payment_receive_wizard" model="ir.ui.view">
        <field name="name">batch.payment.receive.wizard.form</field>
        <field name="model">batch.payment.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Batch Payment" class="o_batch_payment_form">

                <group>
                    <group>

                        <field name="batch_id" readonly="1"/>

                        <field name="amount_due" readonly="1"/>

                        <field name="amount_received"/>

                        <field name="difference" readonly="1"/>
                    </group>

                    <group>
                        <field name="payment_date"/>

                        <field name="journal_id"/>

                        <field name="payment_method_line_id"/>

                        <field name="notes"/>

                    </group>

                </group>


                <footer>

                    <button
                            name="action_receive_payment"
                            type="object"
                            string="Receive Payment"
                            class="btn-primary"/>

                    <button
                            string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>