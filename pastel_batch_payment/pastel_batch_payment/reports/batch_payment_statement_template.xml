<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="batch_payment_statement">

        <t t-call="web.html_container">

            <t t-foreach="docs"
               t-as="o">

                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>
                            Batch Payment Statement
                        </h2>

                        <br/>

                        <div class="row mb-2">

                            <div class="col-3">
                                <strong>Credit Balance:</strong>
                            </div>

                            <div class="col-3">
                                <span t-field="o.partner_id.credit_balance"/>
                            </div>

                        </div>
                        <table class="table table-sm table-bordered">

                            <tr>
                                <td>
                                    <strong>Batch Ref</strong>
                                </td>
                                <td>
                                    <span t-field="o.name"/>
                                </td>

                                <td>
                                    <strong>Status</strong>
                                </td>
                                <td>
                                    <span t-field="o.state"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Customer</strong>
                                </td>
                                <td>
                                    <span t-field="o.partner_id"/>
                                </td>

                                <td>
                                    <strong>Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.payment_date"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Customer Ref</strong>
                                </td>
                                <td>
                                    <span t-field="o.partner_id.customer_reference"/>
                                </td>

                                <td>
                                    <strong>Currency</strong>
                                </td>
                                <td>
                                    <span t-field="o.currency_id"/>
                                </td>
                            </tr>

                        </table>

                        <br/>

                        <table class="table table-sm table-bordered">

                            <thead>

                                <tr>

                                    <th>Invoice</th>
                                    <th>Status</th>
                                    <th class="text-end">
                                        Invoice Amount
                                    </th>

                                    <th class="text-end">
                                        Paid
                                    </th>

                                    <th class="text-end">
                                        Outstanding
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                <tr t-foreach="o.line_ids"
                                    t-as="line">

                                    <td>
                                        <span t-field="line.move_id"/>
                                    </td>

                                    <td>
                                        <span t-field="line.move_id.batch_payment_state"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="line.amount"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="line.move_id.amount_paid_batch"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-esc="line.move_id.amount_outstanding_batch"/>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                        <br/>

                        <table class="table table-sm table-bordered">

                            <tr>

                                <td>
                                    Total Due
                                </td>

                                <td class="text-end">
                                    <span t-esc="o.amount_due"/>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Amount Received
                                </td>

                                <td class="text-end">
                                    <span t-esc="o.amount_received"/>
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    Outstanding Balance
                                </td>

                                <td class="text-end">
                                    <span t-esc="o.amount_due - o.amount_received"/>
                                </td>

                            </tr>

                        </table>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>