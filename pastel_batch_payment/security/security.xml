<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Finance Clerk -->
    <record id="group_finance_clerk" model="res.groups">
        <field name="name">Finance Clerk</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <!-- Finance Manager -->
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('pastel_batch_payment.group_finance_clerk'))]"/>
    </record>

</odoo>