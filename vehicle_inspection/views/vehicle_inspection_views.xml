                                           width="300"/>

                                    <field name="category_id"
                                           invisible="display_type == 'line_section'"
                                           width="220"/>

                                    <field name="item_id"
                                           invisible="display_type == 'line_section'"
                                           width="350"/>

                                    <field name="result"
                                           invisible="display_type == 'line_section'"
                                           widget="radio"
                                           options="{'horizontal': True}"
                                           width="180"/>

                                    <field name="require_photo"
