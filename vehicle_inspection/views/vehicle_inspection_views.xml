        <field name="res_model">vehicle.inspection</field>
        <field name="view_mode">tree,form</field>
        <field name="views" eval="[
        (ref('view_vehicle_inspection_tree'), 'tree'),
        (ref('view_vehicle_inspection_form'), 'form')
    ]"/>
    </record>
