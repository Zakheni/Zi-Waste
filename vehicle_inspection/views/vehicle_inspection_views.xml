<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_inspection_tree" model="ir.ui.view">
        <field name="name">vehicle.inspection.tree</field>
        <field name="model">vehicle.inspection</field>
        <field name="arch" type="xml">
            <tree>

                <field name="name"/>
                <field name="inspection_type" optional="hide"/>
                <field name="vehicle_id"/>
                <field name="inspector_id" widget="many2one_avatar_user"/>
                <field name="partner_id" optional="hide"/>
                <field name="driver_id" widget="many2one_avatar_user"/>
                <field name="comment" optional="hide"/>
                <field name="km_open" optional="hide"/>
                <field name="vehicle_description" optional="hide"/>
                <field name="km_close" optional="hide"/>
                <field name="inspection_date" optional="hide"/>
                <field name="next_inspection_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'faulty'"
                       decoration-warning="state == 'not_running'"
                       decoration-info="state == 'resolved'"
                       decoration-success="state == 'done'"
                />


            </tree>
        </field>
    </record>

    <record id="view_vehicle_inspection_form" model="ir.ui.view">
        <field name="name">vehicle.inspection.form</field>
        <field name="model">vehicle.inspection</field>
        <field name="arch" type="xml">
            <form>
                <field name="show_notify_button" invisible="1"/>
                <field name="show_resolved_button" invisible="1"/>
                <header>


                    <button name="action_draft"
                            type="object"
                            string="Draft"
                            class="btn-dark"
                            invisible="state == 'draft'"/>

                    <button name="action_open_fault_wizard"
                            type="object"
                            string="Faulty"
                            class="btn-danger"
                            invisible="state != 'draft' or show_notify_button == False"

                    />

                    <!--                    <button name="action_open_fault_wizard"-->
                    <!--                            type="object"-->
                    <!--                            string="Notify Manager"-->
                    <!--                            class="btn-danger"-->
                    <!--                            invisible="show_notify_button == False"/>-->

                    <button name="action_open_not_running_wizard"
                            type="object"
                            string="Not Running"
                            class="btn-warning"
                            invisible="state != 'draft' or show_notify_button == False"/>

                    <!--                            invisible="state not in ('draft','faulty')" />-->


                    <button name="action_open_resolved_wizard"
                            type="object"
                            string="Resolved"
                            class="btn-success"
                            invisible="show_resolved_button == False or state in ('resolved','done')"/>

                    <button name="action_open_resolved_not_running_wizard"
                            type="object"
                            string="Resolved"
                            class="btn-success"
                            invisible="state in ('draft','resolved','done') or show_resolved_button == True"/>

                    <button name="action_done"
                            type="object"
                            string="Done"
                            class="btn-primary"
                            invisible="state != 'resolved'"/>

                    <button name="action_print_inspection_report"
                            type="object"
                            string="Print Inspection Report"
                            class="btn-primary"
                            invisible="state != 'done'"
                    />


                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft, faulty, not_running, resolved, done"/>

                </header>


                <sheet>
                    <group>
<!--                        <field name="vehicle_available"/>-->
<!--                        <field name="is_vehicle_available"/>-->
                    </group>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group string="Vehicle information">
                        <group>
                            <!--                            <field name="inspection_type" readonly="state != 'draft'"/>-->
                            <field name="vehicle_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <!--                            <field name="partner_id" readonly="state != 'draft'"/>-->
                            <field name="driver_id" string="Driver" widget="many2one_avatar_user"
                                   readonly="1"/>
                            <field name="inspection_date" readonly="state != 'draft'"/>


                            <field name="comment" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="km_open" readonly="state != 'draft'"/>
                            <field name="km_close" readonly="state != 'draft'"/>


                            <!--                            <field name="inspector_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>-->
                            <!--                            <field name="next_inspection_date" readonly="state != 'draft'"/>-->
                            <field name="vehicle_description" readonly="state != 'draft'"/>


                        </group>
                    </group>

                    <field name="used_item_ids" invisible="1"/>

                    <notebook>
                        <!--                        <page string="Checklist">-->
                        <!--                            <field name="line_ids" readonly="state != 'draft'">-->
                        <!--                                <tree editable="bottom">-->
                        <!--                                    <field name="category_id"/>-->
                        <!--                                    <field name="item_id"-->
                        <!--                                           domain="[('id', 'not in', parent.used_item_ids)]"/>-->
                        <!--                                    <field name="result" widget="radio"-->
                        <!--                                           options="{'horizontal': True}" string="Check"/>-->
                        <!--                                    <field name="note"/>-->
                        <!--                                    <field name="require_photo"/>-->

                        <!--                                    &lt;!&ndash; 📷 PHOTO BUTTON &ndash;&gt;-->
                        <!--                                    <button name="open_line_form"-->
                        <!--                                            type="object"-->
                        <!--                                            icon="fa-camera"-->
                        <!--                                            string="Photos"-->
                        <!--                                            invisible="require_photo == False"/>-->

                        <!--                                </tree>-->

                        <!--                                &lt;!&ndash;                                 <form ref="vehicle_inspection.view_inspection_line_photo_form"/>&ndash;&gt;-->
                        <!--                                <form ref="vehicle_inspection.view_inspection_line_form"/>-->

                        <!--                            </field>-->
                        <!--                        </page>-->


                        <page string="Checklist">

                            <field name="line_ids"
                                   readonly="state != 'draft'">

                                <tree>
                                    <field name="category_id"/>

                                    <field name="item_id"
                                           domain="[('id', 'not in', parent.used_item_ids)]"/>

                                    <field name="result"
                                           widget="radio"
                                           options="{'horizontal': True}"
                                           string="Check"/>

                                    <field name="note"/>

                                    <field name="require_photo" invisible="result != 'fault'"/>

                                </tree>


                                <form>

                                    <sheet>


                                        <group>
                                            <group>
                                                <field name="category_id" readonly="1"/>
                                                <field name="item_id"/>
                                                <field name="result"
                                                       widget="radio"
                                                       options="{'horizontal': True}"
                                                       invisible="item_id == False"/>
                                                <field name="result" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="note"/>
                                                <field name="require_photo" invisible="result != 'fault'"/>
                                            </group>
                                            <!--                                            <group string="Photos"-->
                                            <!--                                                   invisible="result != 'fault'">-->

                                            <field name="photo_ids" invisible="result != 'fault'">

                                                <tree editable="bottom">

                                                    <field name="image"
                                                           widget="image"/>

                                                    <field name="name"/>


                                                </tree>

                                                <form>

                                                    <sheet>

                                                        <group>

                                                            <field name="image" required="1"
                                                                   widget="image"/>

                                                            <field name="name" required="1"/>


                                                        </group>

                                                    </sheet>

                                                </form>

                                            </field>

                                        </group>
                                        <!--                                        </group>-->

                                    </sheet>

                                </form>

                            </field>

                        </page>
                        <page string="Photos">
                            <field name="image_ids" mode="kanban">
                                <kanban>
                                    <field name="image"/>
                                    <field name="name"/>

                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_card oe_kanban_global_click">
                                                <img t-att-src="kanban_image(
                            'vehicle.inspection.image',
                            'image',
                            record.id.value
                        )"
                                                     style="width:100%; height:220px; object-fit:cover;"/>
                                                <div class="oe_kanban_details">
                                                    <strong>
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>


                        <page string="Signature">
                            <field name="signature" widget="signature" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_vehicle_inspection" model="ir.actions.act_window">
        <field name="name">Vehicle Inspections</field>
        <field name="res_model">vehicle.inspection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
