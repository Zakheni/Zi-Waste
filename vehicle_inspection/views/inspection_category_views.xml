<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_inspection_category_tree" model="ir.ui.view">
        <field name="name">vehicle.inspection.category.tree</field>
        <field name="model">vehicle.inspection.category</field>
        <field name="arch" type="xml">
            <tree string="Vehicle Inspection Category">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_vehicle_inspection_category_form" model="ir.ui.view">
        <field name="name">vehicle.inspection.category.form</field>
        <field name="model">vehicle.inspection.category</field>
        <field name="arch" type="xml">
            <form string="Vehicle Inspection Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence" readonly="1"/>

                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_inspection_category" model="ir.actions.act_window">
        <field name="name">Inspection Categories</field>
        <field name="res_model">vehicle.inspection.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
