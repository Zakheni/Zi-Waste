<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- Vehicle Inspection Line FORM -->
    <!-- ========================================= -->

    <record id="view_inspection_line_form" model="ir.ui.view">
        <field name="name">vehicle.inspection.line.form</field>
        <field name="model">vehicle.inspection.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="require_photo" invisible="1"/>

                    <group>

                        <group>
                            <field name="category_id" readonly="1"/>
                            <field name="item_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="result" widget="radio"
                                   options="{'horizontal': True}"/>
                            <field name="note"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Photos">
                            <field name="photo_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="image" widget="image" rerequired="1"/>
                                    <field name="name" rerequired="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================================= -->
    <!-- Photo FORM (FULL PREVIEW) -->
    <!-- ========================================= -->
    <record id="view_inspection_line_photo_form" model="ir.ui.view">
        <field name="name">vehicle.inspection.line.photo.form</field>
        <field name="model">vehicle.inspection.image</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="image"
                               widget="image"
                               options="{'size': [800, 800]}"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
