<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE VIEW -->

    <record id="view_vehicle_inspection_history_tree" model="ir.ui.view">
        <field name="name">vehicle.inspection.history.tree</field>
        <field name="model">vehicle.inspection</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <tree string="Inspection History" create="0">

                <field name="name"/>
                <field name="vehicle_id" widget="many2one_avatar_user"/>
                <field name="driver_id" widget="many2one_avatar_user"/>
                <field name="inspection_date"/>
                <field name="inspector_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'faulty'"
                       decoration-warning="state == 'not_running'"
                       decoration-info="state == 'resolved'"
                       decoration-success="state == 'done'"
                />


            </tree>

        </field>

    </record>


    <!-- FORM VIEW -->

    <record id="view_vehicle_inspection_history_form" model="ir.ui.view">
        <field name="name">vehicle.inspection.history.form</field>
        <field name="model">vehicle.inspection</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">

            <form string="Inspection History" create="0">

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>

                        <group>
                            <field name="inspection_date"/>
                            <field name="state"/>
                            <field name="inspector_id"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Comments">
                            <field name="comment"/>
                        </page>

                        <page string="Inspection Lines">
                            <field name="line_ids"/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ACTION -->

    <record id="action_vehicle_inspection_history" model="ir.actions.act_window">
        <field name="name">Inspection History</field>
        <field name="res_model">vehicle.inspection</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('active','=',False),('state','=','done')]</field>
        <field name="context">{'active_test': False}</field>

    </record>


    <!-- ACTION TREE VIEW -->

    <record id="action_vehicle_inspection_history_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_vehicle_inspection_history_tree"/>
        <field name="act_window_id" ref="action_vehicle_inspection_history"/>

    </record>


    <!-- ACTION FORM VIEW -->

    <record id="action_vehicle_inspection_history_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vehicle_inspection_history_form"/>
        <field name="act_window_id" ref="action_vehicle_inspection_history"/>

    </record>


    <!-- MENU -->

    <menuitem
            id="menu_vehicle_inspection_configuration"
            name="Configuration"
            parent="menu_vehicle_inspection_root"
            sequence="99"
    />

    <menuitem
            id="menu_vehicle_inspection_history"
            name="Inspection History"
            parent="menu_vehicle_inspection_configuration"
            action="action_vehicle_inspection_history"
            sequence="99"
    />

</odoo>