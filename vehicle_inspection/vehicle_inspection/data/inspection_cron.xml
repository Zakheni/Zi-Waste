<?xml version="1.0" encoding="utf-8"?>
<!--
    Vehicle Inspection - Scheduled Actions
    Daily cron to schedule todo activities for upcoming inspections.
-->
<odoo>

    <!-- ============================= -->
    <!-- INSPECTION REMINDER CRON -->
    <!-- ============================= -->
    <record id="inspection_reminder_cron" model="ir.cron">
        <field name="name">Inspection Reminder</field>
        <field name="model_id" ref="model_vehicle_inspection"/>
        <field name="state">code</field>
        <field name="code">model.cron_schedule_inspection_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
