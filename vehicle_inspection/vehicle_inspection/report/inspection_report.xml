<?xml version="1.0" encoding="utf-8"?>
<!--
    Vehicle Inspection - Report Action
    PDF report binding for vehicle inspection records.
-->
<odoo>

    <!-- ============================= -->
    <!-- INSPECTION PDF REPORT -->
    <!-- ============================= -->
    <record id="action_vehicle_inspection_report" model="ir.actions.report">
        <field name="name">Vehicle Inspection Report</field>
        <field name="model">vehicle.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_inspection.vehicle_inspection_report_template</field>
        <field name="report_file">vehicle_inspection.vehicle_inspection_report_template</field>
        <field name="binding_model_id" ref="model_vehicle_inspection"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
