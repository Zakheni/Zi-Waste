<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tree_service_request" model="ir.ui.view">
        <field name="name">waste.service.request.tree</field>
        <field name="model">waste.service.request</field>
        <field name="arch" type="xml">
            <tree default_order="create_date desc" string="Waste Service Request">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="service_requested_id"/>
                <field name="wizard_pickup_point_ids" widget="many2many_tags"/>
                <field name="dropoff_container_ids" widget="many2many_tags" optional="hide"/>
                <field name="lifted_bin_ids" widget="many2many_tags" optional="hide"/>
                <field name="dropped_bin_ids" widget="many2many_tags" optional="hide"/>
                <field name="shunted_bin_ids" widget="many2many_tags" optional="hide"/>
                <field name="shunt_to_id" optional="hide"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'generated'"
                       decoration-danger="state == 'cancelled'"
                       decoration-warning="state == 'draft'"/>
            </tree>
        </field>
    </record>
    <record id="view_form_service_request" model="ir.ui.view">
        <field name="name">waste.service.request.form</field>
        <field name="model">waste.service.request</field>
        <field name="arch" type="xml">
            <form string="Waste Service Request" edit="1">
                <header>

                    <button string="Draft" type="object" name="action_draft" class="btn-primary"

                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk"/>

                    <!-- NEW: Schedule -->
                    <button string="Schedule"
                            type="object"
                            name="action_set_scheduled"
                            class="btn-info"
                            invisible="state != 'generated'"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk"/>

                    <!--                    &lt;!&ndash; NEW: Assign &ndash;&gt;-->
                    <!--                    <button string="Assign"-->
                    <!--                            type="object"-->
                    <!--                            name="action_set_assigned"-->
                    <!--                            class="btn-info"-->
                    <!--                            invisible="state != 'assigned' and state != 'scheduled' or is_service_provider == False"-->
                    <!--                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk"/>-->


                    <button string="Generate" type="object" name="action_generated" class="btn-info"
                            invisible="state != 'draft'"/>
                    <!--                            invisible="state != 'scheduled' or is_service_provider == True"/>-->
                    <button string="Authorise" type="object" name="action_mark_done" class="btn-success"
                            invisible="state != 'service_delivered' or worksheet_count == 0"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_manager"/>
                    <button string="Reject" type="object" name="action_cancelled" class="btn-danger"
                            invisible="state != 'service_delivered' or worksheet_count == 0"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_manager"/>
                    <button string="Amend" type="object" name="action_amend" class="btn-primary"
                            invisible="state != 'cancelled' or worksheet_count == 0"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk"/>
                    <button name="action_open_related_sales" type="object"
                            string="Create Invoice" class="btn-primary"
                            invisible="state != 'done'"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_manager,waste_management_zakheni.group_wmz_finance"/>


                    <button name="action_open_simple_provider_wizard"
                            type="object"
                            string="Find Service Provider"
                            class="oe_highlight"
                            invisible="is_service_provider == False or state != 'draft'"

                    />

                    <button name="action_push_extra_products_to_so"
                            type="object"
                            string="Update Sales Order"
                            class="btn-primary"
                            groups="waste_management_zakheni.group_wmz_admin,aste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_finance,waste_management_zakheni.group_wmz_manager"

                            invisible="sale_order_id == False or state != 'scheduled' and state != 'dispatched' and state != 'cancelled' or extra_product_count == 0 "/>


                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,scheduled,dispatched,service_delivered,done,cancelled"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_worksheet"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-edit"

                                invisible="state != 'scheduled' and state != 'dispatched' and state != 'cancelled'"
                        >
                            <field name="worksheet_count" widget="statinfo"/>
                        </button>

                        <button name="action_open_product_selector"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                groups="waste_management_zakheni.group_wmz_admin,aste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_finance,waste_management_zakheni.group_wmz_manager"
                                invisible="state != 'scheduled' and state != 'dispatched' and state != 'cancelled'"

                        >
                            <field name="extra_product_count"
                                   widget="statinfo"
                                   string="Extra Products"/>
                        </button>

                        <button name="action_open_bin_assignment_wizard"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="sale_order_id == False"
                                string="Assign Bins"
                                groups="waste_management_zakheni.group_wmz_admin,aste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_finance,waste_management_zakheni.group_wmz_manager"


                        >

                            <!-- Pickup Points -->
                            <field name="wizard_pickup_point_count"
                                   widget="statinfo"
                                   string="Pickup Point(s)"
                            />

                            <!-- Slash separator -->
                            <span style="font-size:14px; padding:0 4px;">|</span>

                            <!-- Bins -->
                            <field name="bin_line_count"
                                   widget="statinfo"
                                   string="Bin(s)"
                            />
                        </button>
                        <button name="action_open_sale_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-external-link"
                                string="Sales Order"
                                invisible="sale_order_id == False"
                                groups="waste_management_zakheni.group_wmz_admin,aste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_finance,waste_management_zakheni.group_wmz_manager"
                        >
                            <!--                            <field name="sale_order_count" widget="statinfo" string="Order(s)"/>-->
                            <field name="sale_order_id" widget="statinfo" string="Order(s)"/>
                        </button>

                    </div>

                    <div class="alert alert-danger d-flex align-items-start" style="font-size:14px;"
                         invisible="state != 'cancelled'">
                        <i class="fa fa-times-circle" style="font-size:20px; margin-right:10px; margin-top:2px;"/>
                        <div>
                            <strong>Rejected Reason:</strong>
                            <br/>
                            <field name="reject_reason" readonly="1"/>
                        </div>
                    </div>

                    <div class="alert alert-info d-flex align-items-start" style="font-size:14px;"
                         invisible="state != 'service_delivered' or is_rejected == False">
                        <i class="fa fa-info-circle" style="font-size:20px; margin-right:10px; margin-top:2px;"/>
                        <div>
                            <strong>Amendments:</strong>
                            <br/>
                            <field name="amend_comment" readonly="1"/>

                        </div>
                    </div>
                    <group>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="state != 'draft'"/>
                            </h1>
                        </div>

                        <group>
                            <field name="is_rejected" invisible="1" readonly="1"/>
                        </group>

                    </group>
                    <group string="container location">
                        <group>
                            <field name="service_request_date" readonly="state != 'draft' and state != 'cancelled'"/>
                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   options="{'no_open': True}"
                                   readonly="state != 'draft' and state != 'cancelled'"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   placeholder="Type to find a customer..."/>
                            <field name="sale_order_id" required="1"
                                   options="{'no_open': True}"
                                   readonly="state != 'draft' and state != 'cancelled'"
                                   domain="[('partner_id', '=', partner_id),
                                                     ('validity_date', '>=', context_today()),
                                                     ('state', '=', 'sale'),
                                                     ('invoice_status', '=', 'to invoice'),
                                                     ('service_request_id', '=', False)]"
                            />


                            <field name="hide_waste_type" invisible="1"/>
                            <field name="hide_waste_details" invisible="1"/>
                            <field name="hide_bin" invisible="1"/>
                            <field name="hide_tank" invisible="1"/>

                            <field name="service_requested_id"
                                   options="{'no_open': True}"
                                   readonly="state != 'draft'"/>

                            <field name="waste_type_id" readonly="state != 'draft'"
                                   invisible="hide_waste_type == True"/>

                            <field name="waste_details_id"
                                   options="{'no_open': True}"
                                   readonly="state != 'draft'"
                                   invisible="hide_waste_details == True"/>

                            <field name="bin_type_id"
                                   options="{'no_open': True}"
                                   readonly="state != 'draft' "
                                   invisible="hide_tank == True and hide_bin == False"/>
                            <field name="container_type_id"  readonly="state != 'draft'" widget="radio"
                                   options="{'horizontal': True}"/>


                        </group>
                        <group>

                            <field name="pickup_id" invisible="1"/>
                            <field name="hide_droppoff_container_ids_placement" invisible="1"/>
                            <field name="hide_droppoff_container_ids_removal" invisible="1"/>
                            <field name="hide_droppoff_container_ids_collection" invisible="1"/>
                            <field name="hide_droppoff_container_ids_is_bin" invisible="1"/>


                            <!--                            &lt;!&ndash;                            <field name="pickup_point_id" readonly="state != 'draft'" invisible="0"/>&ndash;&gt;-->
                            <!--                            <field name="pickup_point_ids" readonly="state != 'draft'"-->
                            <!--                                   widget="many2many_tags"-->
                            <!--                                   invisible="0"/>-->
                            <field name="wizard_pickup_point_ids" widget="many2many_tags" readonly="1"/>
                            <field name="pickup_point_bins_summary" readonly="1" class="text-muted"
                                   style="font-size:10px;"
                                   placeholder="No bins assigned yet."/>
                            <field name="dropoff_container_ids" string="Bin. No" widget="many2many_tags"
                                   required="hide_droppoff_container_ids_placement == False"
                                   readonly="1"
                                   invisible="hide_droppoff_container_ids_placement == False or hide_tank == True"
                                   domain="['&amp;','&amp;','&amp;',('status', '=', 'intact'), ('tank_volume_id', 'not in',('7000_liters','9000_liters','11000_liters','12000_liters','15000_liters')), ('pickup_point_id', '=', False), ('bin_type_id', '=', bin_type_id), ('inUse', '=', False)]"/>


                            <field name="dropoff_container_ids" widget="many2many_tags" required="0"
                                   readonly="state != 'draft' and state != 'cancelled'" string="Bin. No"
                                   invisible="hide_droppoff_container_ids_removal == False"
                                   domain="['&amp;', ('status', 'in', ['intact','in_use']), ('pickup_point_id', '=', pickup_id) ]"/>


                            <field name="dropoff_container_ids" widget="many2many_tags" readonly="0"
                                   required="0" string="Bin. No"
                                   invisible="hide_droppoff_container_ids_collection == False or hide_droppoff_container_ids_is_bin == False "
                                   domain="['&amp;','&amp;',('status', 'in', ['intact','in_use']),('container_type_id' ,'!=','Tank'),('pickup_point_id', '=', pickup_id) ]"/>


                            <field name="hide_lifted_bin_ids_swap" invisible="1"/>
                            <field name="hide_dropped_bin_ids_swap" invisible="1"/>
                            <field name="hide_dropped_to_swap" invisible="1"/>
                            <!--  Swap  -->
                            <field name="lifted_bin_ids" widget="many2many_tags" required="0"
                                   readonly="state != 'draft' and state != 'cancelled'"
                                   invisible="hide_lifted_bin_ids_swap == False"
                                   domain="['&amp;',('status', 'in', ['broken','in_use','un_use']),('pickup_point_id', '=', pickup_id) ]"/>
                            <field name="dropped_bin_ids" widget="many2many_tags" required="0"
                                   readonly="state != 'draft' and state != 'cancelled'"
                                   invisible="hide_dropped_to_swap == False"
                                   domain="[('status', '=', 'intact')]"/>
                            <field name="pickup_point_id" invisible="hide_dropped_to_swap == False" required="0"
                                   readonly="state != 'draft' and state != 'cancelled'"/>

                            <field name="hide_shunt_container_ids" invisible="1"/>
                            <field name="hide_shunt_to_id" invisible="1"/>

                            <field name="shunt_container_ids" string="Bin Lifted" widget="many2many_tags" required="0"
                                   readonly="state != 'draft' and state != 'cancelled'"
                                   invisible="hide_shunt_container_ids == False"
                                   domain="['&amp;', ('status', 'in', ['in_use','un_use',]), ('pickup_point_id', '=', pickup_id) ]"/>
                            <field name="shunt_to_id" string="Drop off Point"
                                   readonly="state != 'draft' and state != 'cancelled'" required="0"
                                   invisible="hide_shunt_to_id == False"/>

                            <field name="hide_tank_ids" invisible="1"/>
                            <field name="hide_tank_volume" invisible="1"/>
                            <field name="hide_liters_collected" invisible="1"/>
                            <field name="hide_liters_remaining" invisible="1"/>
                            <field name="hide_service_collection" invisible="1"/>


                            <field name="tank_ids" widget="many2many_tags"
                                   invisible="hide_tank_ids == False or hide_service_collection == False"
                                   readonly="state != 'draft' and state != 'cancelled'"

                            />
                            <!--                                   domain="['&amp;', '&amp;',  ('status', 'in', ['in_use']), ('hide_tank' ,'=' , False), ('pickup_point_id', '=', pickup_id)]"/>-->
                            <field name="tank_volume_id" readonly="0"
                                   invisible="hide_tank_volume == False or hide_service_collection == False"/>
                            <field name="liters_collected" readonly="state != 'draft' and state != 'cancelled'"
                                   invisible="hide_liters_collected == False or hide_service_collection == False"/>
                            <field name="liters_remaining" readonly="1"
                                   invisible="hide_liters_remaining == False or hide_service_collection == False"/>
                            <field name="product_uom_qty" string="No. of Bins" readonly="state != 'draft'"/>
                            <field name="planned_date" string="Planned Date"
                                   readonly="state != 'draft' and state != 'cancelled' and state != 'generated'"/>

                            <field name="hide_hazardous_fields" invisible="1"/>
                            <field name="hide_general" invisible="1"/>
                            <field name="hide_none_general" invisible="1"/>
                            <field name="hide_service_placement" invisible="1"/>
                            <field name="hide_disposal_site" invisible="1"/>


                            <field name="UN_No_SIN_No" readonly="state != 'draft' and state != 'cancelled'"
                                   invisible="hide_hazardous_fields == False or hide_service_placement == True"/>
                            <field name="waste_profile_Data_sheet_No"
                                   readonly="state != 'draft' and state != 'cancelled'"
                                   invisible="hide_hazardous_fields == False or hide_service_placement == True"/>
                            <field name="DTNumber" readonly="state != 'draft' and state != 'cancelled'"
                                   invisible="hide_hazardous_fields == False or hide_service_placement == True"/>
                            <field name="quote_no" readonly="state != 'draft' and state != 'cancelled'"/>
                            <field name="disposal_site_id" readonly="state != 'draft' and state != 'cancelled'"
                                   string="Disposal Site"
                                   invisible="hide_general == False and hide_none_general == False and hide_hazardous_fields == False or hide_service_placement == True or hide_shunt_to_id == True"/>
                            <field name="service_description" readonly="state != 'draft' and state != 'cancelled'"/>

                            <separator/>
                            <field name="is_service_provider" readonly="state != 'draft' and state != 'cancelled'"/>

                        </group>
                    </group>


                    <group string="drivers &amp; assistance" invisible="is_service_provider == True">
                        <group>
                            <field name="driver_id" widget="many2one_avatar_user"

                                   readonly="state != 'scheduled' and state != 'draft' and state != 'generated' and state != 'cancelled'"
                                   domain="[('id', 'not in', busy_driver_ids or [])]"/>

                            <field name="assistance_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft' and state != 'generated' and state != 'cancelled'"
                                   domain="[('id', 'not in', busy_assistance_ids or [])]"/>

                        </group>
                        <group>
                            <field name="vehicle_id" widget="many2one_avatar_user"

                                   readonly="state != 'scheduled' and state != 'draft' and state != 'generated' and state != 'cancelled'"
                                   domain="[('id', 'not in', busy_track_ids or [])]"/>
                            <field name="trailer_id" widget="many2one_avatar_user"
                                   readonly="state != 'scheduled' and state != 'draft'  and state != 'generated'  and state != 'cancelled'"
                                   domain="[('id', 'not in', busy_trailler_ids or [])]"/>

                        </group>

                    </group>
                    <notebook>
                        <page string="Busy drivers &amp; assistants and Tucks &amp; Traillers"
                              invisible="is_service_provider == True">
                            <group>
                                <group string="Busy Trucks and Drivers">
                                    <field name="busy_driver_ids" string="Drivers" widget="many2many_tags"/>
                                    <field name="busy_track_ids" string="Trucks" widget="many2many_tags"/>
                                </group>

                                <group string="Busy Assistants and Trailers">
                                    <field name="busy_assistance_ids" string="Assistants" widget="many2many_tags"/>
                                    <field name="busy_trailler_ids" string="Trailers" widget="many2many_tags"/>
                                </group>
                            </group>


                        </page>
                        <page string="Service Provider" invisible="is_service_provider == False">
                            <group string="Service Provider (Result)"
                                   invisible="provider_id == False">
                                <group>
                                    <field name="provider_id" invisible="1" required="is_service_provider == True"/>
                                    <field name="provider_name" readonly="1"/>
                                    <field name="provider_province" readonly="1"/>
                                    <field name="provider_email" readonly="1" widget="email"/>
                                    <field name="provider_phone" readonly="1" widget="phone"/>
                                </group>
                                <group>
                                    <field name="provider_city" readonly="1"/>
                                    <field name="provider_suburb" readonly="1"/>
                                    <field name="provider_phone" readonly="1"/>
                                    <field name="provider_mobile" readonly="1" widget="phone"/>

                                </group>

                            </group>
                        </page>
                    </notebook>


                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_waste_service_request" model="ir.actions.act_window">
        <field name="name">Waste service request</field>
        <field name="res_model">waste.service.request</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>





