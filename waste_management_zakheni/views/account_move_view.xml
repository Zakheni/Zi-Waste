<odoo>
    <record id="view_move_form_inherit_waste_so_manifest" model="ir.ui.view">
        <field name="name">account.move.form.inherit.waste.so.manifest</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>

            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">
                    ['&amp;',
                    ('is_company', '=', True),
                    '|',
                    ('company_id', '=', False),
                    ('company_id', '=', company_id)
                    ]
                </attribute>
            </xpath>

            <xpath expr="//page[@name='other_info']/group" position="inside">
                <group>
                    <field name="sale_order_id" options="{'no_create': True}"/>
                    <field name="service_request_id"
                           options="{'no_create': True}"
                           domain="[('sale_order_id', '=', sale_order_id)]"/>
                </group>


            </xpath>

            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <!-- Only these groups can see it -->
                <attribute name="groups">
                    waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_finance
                </attribute>
                <attribute name="invisible">payment_state == 'paid' or state != 'posted' or hide_payment_buttons</attribute>


                <attribute name="string">
                    Register Receipts
                </attribute>
            </xpath>
            <!--            <xpath expr="//button[@name='action_register_payment']"-->
            <!--                   position="attributes">-->
            <!--                <attribute name="invisible">hide_payment_buttons</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//button[@name='action_register_payment_batch']"
                   position="attributes">
                     <attribute name="invisible">payment_state in ('paid','partial') or state != 'posted' or hide_payment_buttons</attribute>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="hide_payment_buttons" invisible="1"/>
                <field name="is_paid_via_batch" invisible="1"/>

            </xpath>

        </field>
    </record>

    <record id="account_move_form_limit_register_payment_batch" model="ir.ui.view">
        <field name="name">account.move.form.limit.register.payment.batch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="pastel_batch_payment.account_move_form_inherit_register_payment_batch"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_register_payment_batch']" position="attributes">
                <attribute name="groups">
                    waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_finance
                </attribute>
                <attribute name="invisible">
                    payment_state == 'paid' or state != 'posted' or batch_payment_state == 'paid'
                </attribute>

                <attribute name="string">
                    Register Receipts(Batch)
                </attribute>

            </xpath>

        </field>
    </record>

    <record id="account_move_invoice_tree_hide_due_date_batch_paid" model="ir.ui.view">
        <field name="name">account.move.invoice.tree.hide.due.date.batch.paid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
            </xpath>


            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="invisible">
                    batch_payment_state == 'paid' or payment_state == 'paid'
                </attribute>
            </xpath>

        </field>
    </record>

    <record id="view_move_form_change_outstanding_message" model="ir.ui.view">
        <field name="name">account.move.form.change.outstanding.message</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[contains(text(), 'You have') and contains(., 'outstanding credits')]"
                   position="attributes">

                <!--                <div groups="account.group_account_invoice,account.group_account_readonly"-->
                <!--                     class="alert alert-info text-center"-->
                <!--                     role="alert"-->
                <!--                     invisible="move_type not in ('out_invoice', 'out_receipt') or not invoice_has_outstanding or payment_state not in ('not_paid', 'partial')">-->

                <!--                    <i>Please note: there are invoices that have not yet been paid.</i>-->

                <!--                </div>-->

                <attribute name="invisible">1</attribute>

            </xpath>

        </field>
    </record>

    <record id="view_move_form_hide_outstanding_buttons" model="ir.ui.view">
        <field name="name">account.move.form.hide.outstanding.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_outstanding_credits_debits_widget']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- ================================================== -->
    <!-- INVOICE LINE -->
    <!-- ================================================== -->
    <record id="view_move_form_transport_fields" model="ir.ui.view">
        <field name="name">account.move.transport.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='quantity']"
                   position="before">

                <field name="number_of_bins"
                       optional="show"/>

                <field name="distance_km"
                       optional="show"/>

                <field name="number_of_trips"
                       optional="show"/>

                <field name="weight_ton" string="Ton"
                       optional="show"/>

                <field name="weight_kg" string="kg"
                       optional="show"/>


            </xpath>

        </field>

    </record>


</odoo>






