<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wms_provider_select_wizard" model="ir.ui.view">
        <field name="name">wms.service.provider.select.wizard.form</field>
        <field name="model">wms.service.provider.select.wizard</field>
        <field name="arch" type="xml">
            <form string="Find Service Provider">
                <group>
                    <group>
                        <field name="province" required="1"/>
                        <field name="city" required="1"/>
                        <field name="suburb"/>
                    </group>
                    <group>
                        <field name="required_category_ids" widget="many2many_tags"
                               placeholder="Optional: must include all selected categories"/>
                        <field name="provider_id" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_find" type="object" string="Find Provider" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>

                <!--                <footer>-->
                <!--                    <button name="action_find"-->
                <!--                            type="object"-->
                <!--                            string="Find Provider"-->
                <!--                            class="btn-primary"/>-->

                <!--                    <button name="action_open_provider"-->
                <!--                            type="object"-->
                <!--                            string="Open Suggested Provider"-->
                <!--                            invisible="provider_id == False"/>-->

                <!--                    <button string="Close" class="btn-secondary" special="cancel"/>-->
                <!--                </footer>-->
            </form>
        </field>
    </record>

    <record id="action_open_provider_wizard" model="ir.actions.act_window">
        <field name="name">Find Provider</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wms.service.provider.select.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_wms_provider_select_wizard"/>
    </record>
</odoo>
