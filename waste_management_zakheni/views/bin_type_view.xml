<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bin_type_tree" model="ir.ui.view">
        <field name="name">bin.type.tree</field>
        <field name="model">bin.type</field>
        <field name="arch" type="xml">
            <tree string="Bin Type" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>


    <record id="action_bin_type" model="ir.actions.act_window">
        <field name="name">Bin Type</field>
        <field name="res_model">bin.type</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create New Bin Type
            </p>
        </field>
    </record>


</odoo>
