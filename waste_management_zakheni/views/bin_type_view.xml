<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bin_type_tree" model="ir.ui.view">
        <field name="name">bin.type.tree</field>
        <field name="model">bin.type</field>
        <field name="arch" type="xml">
            <tree string="Bin Type">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_bin_type_form" model="ir.ui.view">
        <field name="name">bin.type.form</field>
        <field name="model">bin.type</field>
        <field name="arch" type="xml">
            <form string="Bin Type">
                <sheet>
                    <group>
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_bin_type" model="ir.actions.act_window">
        <field name="name">Bin Type</field>
        <field name="res_model">bin.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create New Bin Type
            </p>
        </field>
    </record>


</odoo>
