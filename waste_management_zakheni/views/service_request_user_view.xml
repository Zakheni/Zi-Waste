<odoo>

    <!-- ✅ TREE VIEW -->
    <record id="view_service_request_user_tree" model="ir.ui.view">
        <field name="name">wmz.service.request.user.tree</field>
        <field name="model">wmz.service.request.user</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email" string="Login"/>
                 <field name="lang"/>
                <field name="last_login" string="Last Authentication"/>
                <field name="company_id"/>
                <!--                <field name="role_ids" widget="many2many_tags"/>-->

                <field name="status"
                       widget="badge"
                       decoration-success="status == 'confirmed'"
                       decoration-info="status == 'not_confirmed'"/>
                <field name="state"
                       widget="badge" optional="hide"
                       decoration-success="state == 'created'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'draft'"/>
                <!--                <field name="message"/>-->
                <!--                <field name="message"-->
                <!--                       readonly="1"-->
                <!--                />-->

                <!--                <button name="action_create_user"-->
                <!--                        type="object"-->
                <!--                        string="Create User"-->
                <!--                        class="btn-primary"-->
                <!--                        invisible="state == 'created'"/>-->

                <!--                <button name="action_update_user"-->
                <!--                        type="object"-->
                <!--                        string="Edit User"-->
                <!--                        class="btn-secondary"-->
                <!--                        invisible="state != 'created'"/>-->
            </tree>
        </field>
    </record>

    <!--     ✅ FORM VIEW -->
    <record id="view_service_request_user_form" model="ir.ui.view">
        <field name="name">wmz.service.request.user.form</field>
        <field name="model">wmz.service.request.user</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_user"
                            type="object"
                            string="Create User"
                            class="btn-primary"
                            invisible="state == 'created'"/>

                    <button name="action_update_user"
                            type="object"
                            string="Update User"
                            class="btn-secondary"
                            invisible="state != 'created'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,created,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" string="Name" placeholder="Name and Surname"/>
                        </h1>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="email" string="Name" placeholder="Email Address"/>
                        </h1>
                    </div>
                    <group>

                        <field name="phone"/>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                        <field name="role_ids" widget="many2many_tags"/>
                        <!--                        <field name="state"/>-->

                    </group>


                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ✅ ACTION -->
    <record id="action_service_request_user" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">wmz.service.request.user</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>