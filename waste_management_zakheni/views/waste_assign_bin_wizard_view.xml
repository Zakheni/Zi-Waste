            <!--                    <button string="Cancel"-->
            <!--                            special="cancel"-->
            <!--                            class="btn-secondary"/>-->
            <!--                </footer>-->
            <!--            </form>-->

        </field>
    </record>

    <!-- ACTION GOES HERE -->
    <record id="action_waste_assign_bin_wizard"
            model="ir.actions.act_window">
        <field name="name">Assign Bins</field>
        <field name="res_model">waste.request.assign.bin.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_waste_assign_bin_wizard_form"/>
    </record>
