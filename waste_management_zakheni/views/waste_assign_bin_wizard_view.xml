<odoo>
    <!-- UPDATED WIZARD FORM VIEW -->
    <record id="view_waste_assign_bin_wizard_form"
            model="ir.ui.view">
        <field name="name">waste.request.assign.bin.wizard.form</field>
        <field name="model">waste.request.assign.bin.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Bins to Pickup Points">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="svc_code" readonly="1"/>
                </group>

                <!-- ✅ Only for shunting -->
                <group invisible="svc_code != 'shunting of bins'">
                    <field name="shunt_to_id" options="{'no_create': True}"/>
                    <field name="customer_id"/>
                    <field name="bin_type_id" invisible="1"/>
                </group>

                <group>
                    <field name="line_ids">
                        <tree editable="bottom" create="1" edit="1">
                            <field name="pickup_point_id"/>
                            <field name="svc_code"/>
                            <field name="customer_id" invisible="0"/>
                            <field name="bin_type_id" invisible="0"/>

                            <field name="container_ids"
                                   widget="many2many_tags"
                                   invisible="svc_code in ['shunting of bins','swapping of bins']"/>

                            <field name="shunt_container_ids"
                                   widget="many2many_tags"
                                   invisible="svc_code != 'shunting of bins'"/>

                            <field name="lifted_container_ids"
                                   widget="many2many_tags"
                                   invisible="svc_code != 'swapping of bins'"/>
                            <field name="dropped_container_ids"
                                   widget="many2many_tags"
                                   invisible="svc_code != 'swapping of bins'"/>
<!--                            <field name="pickup_shunt_point_id" string="Shunt To Location"/>-->

                        </tree>
                    </field>
                </group>

                <footer>
                    <button name="action_confirm" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
            <!--            <form string="Assign Bins to Pickup Points">-->
            <!--                <group>-->
            <!--                    <field name="request_id" readonly="1"/>-->
            <!--                    <field name="svc_code" readonly="1"/>-->
            <!--                </group>-->
            <!--                <group>-->
            <!--                    <field name="line_ids">-->
            <!--                        <tree editable="bottom" create="1" edit="1">-->
            <!--                            <field name="svc_code"/>-->
            <!--                            <field name="pickup_point_id"/>-->

            <!--                            &lt;!&ndash; Placement / Removal / Collection &ndash;&gt;-->
            <!--                            <field name="container_ids"-->
            <!--                                   widget="many2many_tags"-->
            <!--                                   invisible="svc_code in ['shunting of bins','swapping of bins']"/>-->

            <!--                            &lt;!&ndash; Shunting &ndash;&gt;-->
            <!--                            <field name="shunt_container_ids"-->
            <!--                                   widget="many2many_tags"-->
            <!--                                   invisible="svc_code != 'shunting of bins'"/>-->

            <!--                            &lt;!&ndash; Swapping &ndash;&gt;-->
            <!--                            <field name="lifted_container_ids"-->
            <!--                                   widget="many2many_tags"-->
            <!--                                   invisible="svc_code != 'swapping of bins'"/>-->
            <!--                            <field name="dropped_container_ids"-->
            <!--                                   widget="many2many_tags"-->
            <!--                                   invisible="svc_code != 'swapping of bins'"/>-->
            <!--                        </tree>-->
            <!--                    </field>-->
            <!--                </group>-->
            <!--                <footer>-->
            <!--                    <button name="action_confirm"-->
            <!--                            type="object"-->
            <!--                            string="Apply"-->
