<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_wmz_inherit" model="ir.ui.view">
        <field name="name">res.company.form.wmz.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Put it under the general company info tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Waste Management" name="wmz_settings"
                >
                    <group string="Service Configuration">
                        <!--                        <field name="wmz_service_ids" widget="many2many_tags"/>-->
                        <!--                        <field name="wmz_container_type_ids" widget="many2many_tags"/>-->
                        <!--                        -->
                        <!--                        <field name="wmz_waste_type_ids"-->
                        <!--                               widget="many2many_tags"-->
                        <!--                               options="{'no_create_edit': True}"-->
                        <!--                               placeholder="Select waste types for this company..."-->
                        <!--                               string="Waste Types for Company"/>-->
                        <field name="wmz_service_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               placeholder="Select services for this company..."
                               string="Waste Services for Company"/>

                        <field name="wmz_container_type_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               placeholder="Select container types for this company..."
                               string="Container Types for Company"/>

                        <field name="wmz_waste_type_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               placeholder="Select waste types for this company..."
                               string="Waste Types for Company"/>

                        <field name="wmz_waste_details_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               placeholder="Select waste details for this company..."
                               string="Waste Details for Company"/>

                        <field name="wmz_bin_type_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               placeholder="Select bin type for this company..."
                               string="Waste Bin Type for Company"/>

                        <field name="wmz_tank_volume_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               placeholder="Select tank volume for this company..."
                               string="Waste Tank Volume for Company"/>

                        <separator string="Allow users who does no have setting to create branch if it is unchecked"/>
                        <field name="is_branch" readonly="1"/>
                    </group>


                </page>
            </xpath>


            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

        </field>
    </record>
</odoo>
