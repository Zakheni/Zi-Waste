<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_service" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.service</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[2]" position="inside">
                <group string="Waste Service">
                    <field name="service_request_id" context="{'default_service_id': active_id}" readonly="1"/>
                    <field name="planned_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

