<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <odoo>
        <record id="view_order_tree_inherit_manifest" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit.manifest</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <!-- Add Manifest column after Customer -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="service_request_id" optional="hide"/>
                    <field name="planned_date"/>
                </xpath>
            </field>
        </record>
    </odoo>

    <record id="view_order_form_inherit_manifest" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.manifest</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Place under Customer -->
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <field name="service_request_id" context="{'default_service_request_id': active_id}" readonly="1"/>
                <field name="planned_date"/>
<!--                <field name="pickup_point_id"/>-->
                <field name="pickup_point_ids" widget="many2many_tags" invisible="partner_id == False"/>
<!--                <field name="container_ids" widget="many2many_tags" context="{'default_sale_order_id': active_id}"-->
<!--                       />-->


            </xpath>
        </field>
    </record>
</odoo>

