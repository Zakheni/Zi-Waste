<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waste_details_tree" model="ir.ui.view">
        <field name="name">waste.details.tree</field>
        <field name="model">waste.details</field>
        <field name="arch" type="xml">
            <tree string="Waste Details" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>


    <record id="action_waste_details" model="ir.actions.act_window">
        <field name="name">Waste Details</field>
        <field name="res_model">waste.details</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create New Waste Details
            </p>
        </field>
    </record>


</odoo>
