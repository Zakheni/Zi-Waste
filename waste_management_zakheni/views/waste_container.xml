<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waste_container_tree" model="ir.ui.view">
        <field name="name">waste.container.tree</field>
        <field name="model">waste.container</field>
        <field name="arch" type="xml">
            <tree default_order="create_date desc" string="Bin List">
                <field name="name"/>
                <field name="image" widget="image" class="oe_avatar" options="{'size': [30, 30]}"/>
                <!--                <field name="container_type_id"/>-->
                <field name="bin_type_id"/>
                <field name="company_id" widget="badge" optional="hide"/>


                <field name="inUse"/>
                <field name="partner_id"/>
                <field name="pickup_point_id"/>
                <field name="reserved_request_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'intact'"
                       decoration-warning="status == 'un_use'"
                       decoration-danger="status == 'in_use'"
                       decoration-primary="status == 'missing'"
                       decoration-info="status == 'broken'"/>


            </tree>
        </field>
    </record>

    <record id="view_waste_container_form" model="ir.ui.view">
        <field name="name">waste.container.form</field>
        <field name="model">waste.container</field>
        <field name="arch" type="xml">
            <form string="Bin Form">
                <header>
                    <field name="status" widget="statusbar" status_visible=""/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="0"/>
                        </h1>
                    </div>
                    <group string="bin information">

                        <group>

                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   placeholder="Type to find a customer..."/>


                            <field name="pickup_point_id"/>
<!--                            <field name="dropoff_point_id"/>-->

                            <field name="liters_collected"
                                   invisible="1"/>
                            <field name="liters_remaining" readonly="1"
                                   invisible="1 "/>

                             <field name="reserved_request_id"/>


                        </group>


                        <group>
                            <field name="hide_tank" invisible="1"/>
                            <field name="hide_bin" invisible="1"/>
                            <field name="status" required="1"/>
                            <field name="bin_type_id" required="1"/>

                            <!--                            <field name="container_type_id" required="1" widget="radio" options="{'horizontal': True}"/>-->
                            <!--                            &lt;!&ndash;                            <field name="container_type_id" required="1"/>&ndash;&gt;-->
                            <!--                            <field name="bin_type_id" required="1" invisible="hide_bin == False"/>-->
                            <!--                            <field name="tank_volume_id" required="1" invisible="hide_tank == False"/>-->
                            <field name="inUse"/>
                            <field name="company_id"/>

                        </group>
                    </group>

                </sheet>
                <!--Chatter-->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_waste_container" model="ir.actions.act_window">
        <field name="name">Bin list</field>
        <field name="res_model">waste.container</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create New Bin
            </p>
        </field>
    </record>
</odoo>