<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit_waste" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.waste</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet//group" position="inside">
                <group string="Tanks">

                    <field name="driver_email"/>
                    <field name="is_waste_tanker"/>
                    <field name="tank_volume_id"
                           invisible="is_waste_tanker == False"/>
                    <field name="tank_capacity_liters"
                           invisible="is_waste_tanker == False"/>
                </group>
            </xpath>

             <!-- REQUIRED: domain helper field -->
        <xpath expr="//form" position="inside">
            <field name="busy_driver_ids" invisible="1"/>
        </xpath>


            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="domain">
                    [
                    ('user_ids.employee_id.job_id.name', '=', 'Driver'),
                    ('id', 'not in', busy_driver_ids)
                    ]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='future_driver_id']" position="attributes">
                <attribute name="domain">
                    [
                    ('user_ids.employee_id.job_id.name', '=', 'Driver'),
                    ('id', 'not in', busy_driver_ids)
                    ]
                </attribute>
            </xpath>




        </field>
    </record>


</odoo>
