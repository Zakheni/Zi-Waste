    <!-- ================================================== -->
    <!-- SEARCH VIEW -->
    <!-- ================================================== -->
    <record id="view_waste_transport_tariff_search" model="ir.ui.view">
        <field name="name">waste.transport.tariff.search</field>
        <field name="model">waste.transport.tariff</field>
        <field name="arch" type="xml">

            <search string="Search Transport Tariffs">

                <field name="name"/>

                <field name="rate_type"/>

                <field name="company_id"/>

                <field name="active"/>

                <group expand="0"
                       string="Group By">

                    <filter string="Rate Type"
                            name="group_by_rate_type"
                            context="{'group_by':'rate_type'}"/>

                    <filter string="Company"
                            name="group_by_company"
                            context="{'group_by':'company_id'}"/>

                </group>

            </search>

        </field>

    </record>

    <!-- ================================================== -->
    <!-- ACTION -->
    <!-- ================================================== -->
    <record id="action_waste_transport_tariff" model="ir.actions.act_window">
        <field name="name">Transport Tariffs</field>
        <field name="res_model">waste.transport.tariff</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_waste_transport_tariff_search"/>

    </record>

</odoo>

