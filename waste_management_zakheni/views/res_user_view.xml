<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_service" model="ir.ui.view">
        <field name="name">res.users.form.inherit.service</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet" position="after">
                <chatter/>
            </xpath>

            <!-- Add new tab inside notebook -->
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Audit Trail">
                    <field name="audit_message_ids" nolabel="1" readonly="1">
                        <tree string="Audit Trail" create="false" delete="false">
                            <field name="date"/>
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="body"/>
                        </tree>
                    </field>
                </page>
            </xpath>


        </field>


    </record>
</odoo>

