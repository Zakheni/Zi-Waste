<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
         1) REPORT ACTION (Manifest PDF)
    -->
    <record id="action_manifest_report_pdf" model="ir.actions.report">
        <field name="name">Waste Manifest</field>
        <field name="model">waste.service.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">waste_management_zakheni.report_manifest_pdf</field>
        <field name="report_file">waste_management_zakheni.report_manifest_pdf</field>
        <field name="print_report_name">'Manifest - %s' % (object.name or '')</field>

        <!-- Adds it to form Print menu -->
        <field name="binding_model_id" ref="model_waste_service_request"/>
        <field name="binding_type">report</field>
    </record>

    <!--
         2) REPORT TEMPLATE (Advanced Styling + Equal Cells)
    -->
    <template id="report_manifest_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <!-- Advanced PDF-safe styling (wkhtmltopdf friendly) -->
                <style type="text/css">
                    /* ===== Theme Colors ===== */
                    :root{
                    --wmz-primary:#0F766E; /* header teal */
                    --wmz-primary-2:#115E59; /* darker teal */
                    --wmz-header-text:#ffffff;
                    --wmz-border:#d8dde3;
                    --wmz-row:#ffffff;
                    --wmz-row-alt:#f3fbfa; /* zebra */
                    --wmz-k:#f7fafc; /* key cell bg */
                    --wmz-muted:#6b7280;
                    }

                    .wmz{ font-family: Arial, sans-serif; font-size:12px; color:#111827; }
                    .wmz-title{ font-size:20px; font-weight:700; margin:0; padding:0; }
                    .wmz-sub{ font-size:11px; color:var(--wmz-muted); margin-top:2px; }
                    .wmz-hr{ border-top:1px solid var(--wmz-border); margin:10px 0 12px; }

                    /* Header layout */
                    .wmz-row{ width:100%; }
                    .wmz-left{ float:left; width:62%; }
                    .wmz-right{ float:right; width:38%; text-align:right; }
                    .wmz-clear{ clear:both; }

                    .wmz-badge{
                    display:inline-block; padding:3px 10px;
                    border-radius:999px;
                    font-size:10px; font-weight:700;
                    color:var(--wmz-header-text);
                    background:var(--wmz-primary);
                    border:1px solid var(--wmz-primary-2);
                    margin-left:6px;
                    }

                    .wmz-section{ margin-top:12px; }
                    .wmz-section-title{
                    font-size:13px; font-weight:700;
                    margin:0 0 8px;
                    padding:6px 10px;
                    border-left:4px solid var(--wmz-primary);
                    background:#f6fffe;
                    border-radius:6px;
                    }

                    /* ===== Tables: fixed layout + equal columns ===== */
                    table.wmz-table{
                    width:100%;
                    border-collapse:collapse;
                    table-layout:fixed;
                    border:1px solid var(--wmz-border);
                    margin-bottom:10px;
                    }
                    table.wmz-table th, table.wmz-table td{
                    border:1px solid var(--wmz-border);
                    padding:8px 10px;
                    vertical-align:middle;
                    overflow:hidden;
                    text-overflow:ellipsis;
                    word-wrap:break-word;
                    }

                    /* Header color */
                    table.wmz-table thead th{
                    background:var(--wmz-primary);
                    color:var(--wmz-header-text);
                    font-size:11px;
                    font-weight:700;
                    }

                    /* Zebra rows */
                    table.wmz-table tbody tr:nth-child(odd) td{ background:var(--wmz-row); }
                    table.wmz-table tbody tr:nth-child(even) td{ background:var(--wmz-row-alt); }

                    /* Key cells */
                    .wmz-k{
                    font-weight:700;
                    background:var(--wmz-k) !important;
                    color:#111827;
                    }

                    .wmz-muted{ color:var(--wmz-muted); }
                    .wmz-righttxt{ text-align:right; white-space:nowrap; }
                    .wmz-nowrap{ white-space:nowrap; }

                    /* Summary card */
                    .wmz-card{
                    border:1px solid var(--wmz-border);
                    border-radius:10px;
                    padding:12px;
                    background:#f8fffe;
                    }

                    /* Billing columns */
                    .wmz-cols{ width:100%; }
                    .wmz-col{ width:49%; display:inline-block; vertical-align:top; }
                    .wmz-col + .wmz-col{ margin-left:2%; }

                    .wmz-footer{ font-size:10px; color:var(--wmz-muted); margin-top:10px; }

                    .wmz-cols{ width:100%; }
                    .wmz-col{ width:49%; display:inline-block; vertical-align:top; }
                    .wmz-col + .wmz-col{ margin-left:2%; }

                </style>

                <t t-if="not docs">
                    <div class="page wmz">
                        <p class="wmz-title">Waste Manifest</p>
                        <p class="wmz-muted">No manifest record selected.</p>
                    </div>
                </t>

                <t t-foreach="docs" t-as="doc">
                    <div class="page wmz">

                        <!-- Header -->
                        <div class="wmz-row">
                            <div class="wmz-left">
                                <p class="wmz-title">Waste Manifest</p>
                                <div class="wmz-sub">
                                    Status:
                                    <span class="wmz-badge">
                                        <t t-esc="dict(doc._fields['state'].selection).get(doc.state, doc.state or '')"/>
                                    </span>
                                </div>
                            </div>

                            <div class="wmz-right wmz-sub" style="font-size:12px;">
                                <div class="wmz-nowrap">
                                    <strong>Manifest No:</strong>
                                    <span t-esc="doc.name or ''"/>
                                </div>
                                <div class="wmz-nowrap">
                                    <strong>Planned Date:</strong>
                                    <span t-esc="doc.planned_date or ''"/>
                                </div>
                                <div class="wmz-nowrap">
                                    <strong>Request Date:</strong>
                                    <span t-esc="doc.service_request_date or ''"/>
                                </div>
                            </div>
                        </div>
                        <div class="wmz-clear"></div>

                        <div class="wmz-hr"/>

                        <!-- Customer / SO -->
                        <div class="wmz-section">
                            <div class="wmz-section-title">Customer &amp; Order</div>
                            <table class="wmz-table">
                                <colgroup>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                </colgroup>
                                <tbody>
                                    <tr>
                                        <td class="wmz-k">Customer</td>
                                        <td t-esc="doc.partner_id.display_name or ''"/>
                                        <td class="wmz-k">Ticket Type</td>
                                        <td t-esc="doc.ticket_type or ''"/>
                                    </tr>
                                    <tr>
                                        <td class="wmz-k">Quote No</td>
                                        <td t-esc="doc.quote_no or ''"/>
                                        <td class="wmz-k">Sales Order</td>
                                        <td t-esc="doc.sale_order_id.name or ''"/>
                                    </tr>
                                    <tr>
                                        <td class="wmz-k">Service Description</td>
                                        <td colspan="3" style="white-space:pre-wrap;"
                                            t-esc="doc.service_description or ''"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Service / Waste -->
                        <div class="wmz-section">
                            <div class="wmz-section-title">Service &amp; Waste Details</div>
                            <table class="wmz-table">
                                <colgroup>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                </colgroup>
                                <tbody>
                                    <tr>
                                        <td class="wmz-k">Service Requested</td>
                                        <td t-esc="doc.service_requested_id.display_name or ''"/>
                                        <td class="wmz-k">Container Type</td>
                                        <td t-esc="doc.container_type_id.display_name or ''"/>
                                    </tr>
                                    <tr>
                                        <td class="wmz-k">Waste Type</td>
                                        <td t-esc="doc.waste_type_id.display_name or ''"/>
                                        <td class="wmz-k">Waste Details</td>
                                        <td t-esc="doc.waste_details_id.display_name or ''"/>
                                    </tr>
                                    <tr>
                                        <td class="wmz-k">UN No / SIN No</td>
                                        <td t-esc="doc.UN_No_SIN_No or ''"/>
                                        <td class="wmz-k">Waste Profile / Data Sheet No</td>
                                        <td t-esc="doc.waste_profile_Data_sheet_No or ''"/>
                                    </tr>
                                    <tr>
                                        <td class="wmz-k">DTNumber</td>
                                        <td t-esc="doc.DTNumber or ''"/>
                                        <td class="wmz-k">Disposal Site</td>
                                        <td t-esc="doc.disposal_site_id.display_name or ''"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Logistics -->
                        <div class="wmz-section">
                            <div class="wmz-section-title">Logistics</div>
                            <table class="wmz-table">
                                <colgroup>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                    <col style="width:25%"/>
                                </colgroup>
                                <tbody>
                                    <tr>
                                        <td class="wmz-k">Pickup Points</td>
                                        <td>
                                            <t t-esc="', '.join(doc.pickup_point_ids.mapped('display_name')) if doc.pickup_point_ids else ''"/>
                                        </td>
                                        <td class="wmz-k">Drop-off Points</td>
                                        <td>
                                            <t t-esc="', '.join(doc.dropoff_point_ids.mapped('display_name')) if doc.dropoff_point_ids else ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="wmz-k">Vehicle</td>
                                        <td t-esc="doc.vehicle_id.display_name or ''"/>
                                        <td class="wmz-k">Trailer</td>
                                        <td t-esc="doc.trailer_id.display_name or ''"/>
                                    </tr>
                                    <tr>
                                        <td class="wmz-k">Driver</td>
                                        <td t-esc="doc.driver_id.display_name or ''"/>
                                        <td class="wmz-k">Assistance</td>
                                        <td t-esc="doc.assistance_id.display_name or ''"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary -->
                        <div class="wmz-section">
                            <div class="wmz-section-title">Pickup / Drop-off and Containers Summary</div>
                            <div class="wmz-card">
                                <div style="white-space:pre-wrap;">
                                    <t t-esc="doc.pickup_point_bins_summary or ''"/>
                                </div>
                            </div>
                        </div>

                        <!-- Decide if this manifest is BIN container type -->
                        <t t-set="is_bin_container"
                           t-value="(doc.container_type_id and (doc.container_type_id.display_name or '').strip().lower() == 'bin')
            or (doc.container_type_id and (doc.container_type_id.name or '').strip().lower() == 'bin')"/>


                        <!-- =========================
                             Bins (ONLY when Container Type = Bin)
                        ========================= -->


                        <t t-if="is_bin_container">
    <div class="wmz-section">
        <div class="wmz-section-title">Bins Movement</div>

        <table class="wmz-table">
            <colgroup>
                <col style="width:50%"/>
                <col style="width:50%"/>

            </colgroup>
            <thead>
                <tr>
                    <th>Lifted</th>
                    <th>Dropped</th>

                </tr>
            </thead>
            <tbody>

                <!-- Prepare variables -->
                <t t-set="lifted" t-value="doc.bin_lifted_ids"/>
                <t t-set="dropped" t-value="doc.bin_dropped_ids"/>
                <t t-set="max_len" t-value="max(len(lifted), len(dropped))"/>

                <!-- Loop through ALL cases -->
                <t t-foreach="range(max_len)" t-as="i">
                    <tr>

                        <!-- Lifted -->
                        <td>
                            <t t-if="i &lt; len(lifted)">
                                <span t-esc="lifted[i].display_name"/>
                            </t>
                            <t t-else="">-</t>
                        </td>

                        <!-- Dropped -->
                        <td>
                            <t t-if="i &lt; len(dropped)">
                                <span t-esc="dropped[i].display_name"/>
                            </t>

                            <!-- SHUNTING fallback -->
                            <t t-elif="i &lt; len(lifted)">
                                <span t-esc="lifted[i].display_name"/>
                            </t>

                            <t t-else="">-</t>
                        </td>




                    </tr>
                </t>

                <!-- No bins -->
                <t t-if="max_len == 0">
                    <tr>
                        <td colspan="3" class="wmz-muted">No bins recorded</td>
                    </tr>
                </t>

            </tbody>
        </table>
    </div>
</t>

