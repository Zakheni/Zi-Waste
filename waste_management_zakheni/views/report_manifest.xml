                        <!-- =========================
                             Billing (ONLY when Container Type != Bin)
                        ========================= -->
                        <t t-if="not is_bin_container">
                            <div class="wmz-section">
                                <div class="wmz-section-title">Billing</div>

                                <!-- Wrapper table = perfect PDF alignment -->
                                <table class="wmz-table" style="border:none; margin-bottom:0;">
                                    <colgroup>
                                        <col style="width:50%"/>
                                        <col style="width:50%"/>
                                    </colgroup>
                                    <tbody>
                                        <tr>
                                            <!-- LEFT -->
                                            <td style="border:none; padding:0 6px 0 0; background:transparent;">
                                                <table class="wmz-table" style="margin-bottom:0;">
                                                    <colgroup>
                                                        <col style="width:50%"/>
                                                        <col style="width:50%"/>
                                                    </colgroup>
                                                    <tbody>
                                                        <tr>
                                                            <td class="wmz-k">Quantity</td>
                                                            <td class="wmz-righttxt"
                                                                t-esc="doc.product_uom_qty or 0.0"/>
                                                        </tr>
                                                        <tr>
                                                            <td class="wmz-k">Liters Collected</td>
                                                            <td class="wmz-righttxt"
                                                                t-esc="doc.liters_collected or 0.0"/>
                                                        </tr>
                                                        <tr>
                                                            <td class="wmz-k">Billing kL</td>
                                                            <td class="wmz-righttxt" t-esc="doc.billing_kl or 0.0"/>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>

                                            <!-- RIGHT -->
                                            <td style="border:none; padding:0 0 0 6px; background:transparent;">
                                                <table class="wmz-table" style="margin-bottom:0;">
                                                    <colgroup>
                                                        <col style="width:50%"/>
                                                        <col style="width:50%"/>
                                                    </colgroup>
                                                    <tbody>
                                                        <tr>
                                                            <td class="wmz-k">Billing Amount (Excl. VAT)</td>
                                                            <td class="wmz-righttxt" t-esc="doc.billing_amount or 0.0"/>
                                                        </tr>
                                                        <tr>
                                                            <td class="wmz-k">Unit Price</td>
