<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tree_disposal_site" model="ir.ui.view">
        <field name="name">waste.disposal.site.tree</field>
        <field name="model">waste.disposal.site</field>
        <field name="arch" type="xml">
            <tree string="Disposal Sites">
<!--                <field name="name"/>-->
                <field name="waste_type"/>
                <field name="location"/>
                <field name="capacity_tons"/>
                <field name="current_load"/>
                <field name="company_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_form_disposal_site" model="ir.ui.view">
        <field name="name">waste.disposal.site.form</field>
        <field name="model">waste.disposal.site</field>
        <field name="arch" type="xml">
            <form string="Disposal Site">
                <sheet>
                    <h1>
                        <field name="name" readonly="0"/>
                    </h1>
                    <group>
                        <group>
                            <field name="site_code" />
                            <field name="location"/>
                            <field name="waste_type"/>
                            <field name="capacity_tons"/>
                            <field name="current_load"/>
                            <field name="contact_person"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="license_number"/>
                            <field name="inspection_date"/>
                            <field name="next_inspection_date"/>
                            <field name="company_id"/>
                            <field name="phone"/>
                            <field name="active"/>

                        </group>

                        <notebook>
                            <page string="note">
                                <field name="notes" widget="html"/>
                            </page>
                        </notebook>

                    </group>
                </sheet>
                <!--Chatter-->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="action_disposal_site" model="ir.actions.act_window">
        <field name="name">Disposal Sites</field>
        <field name="res_model">waste.disposal.site</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
