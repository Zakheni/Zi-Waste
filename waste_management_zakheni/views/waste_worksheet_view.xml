<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waste_worksheet_tree" model="ir.ui.view">
        <field name="name">waste.worksheet.tree</field>
        <field name="model">waste.worksheet</field>
        <field name="arch" type="xml">
            <tree default_order="create_date desc">
                <field name="name" string="Reference"/>
                <field name="arrival_time"/>
                <field name="kilometers"/>
                <field name="return_date"/>
                <field name="unit_of_measure"/>
                <field name="quantity_collected"/>
                <field name="service_request_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_waste_worksheet_form" model="ir.ui.view">
        <field name="name">waste.worksheet.form</field>
        <field name="model">waste.worksheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_to_draft" type="object" string="Set to Draft"
                            class="btn-secondary"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_driver"
                    />
                    <button name="action_start"
                            type="object"
                            string="Start"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_driver"
                    />
                    <button name="action_done" type="object" string="Mark as done"
                            class="btn-primary"
                            groups="waste_management_zakheni.group_wmz_admin,waste_management_zakheni.group_wmz_admin_clerk,waste_management_zakheni.group_wmz_driver"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>


                        <group>

                            <field name="planned_date" string=" Planned Date" widget="badge" decoration-warning="1"/>
                        </group>

                        <group>
                            <field name="service_request_id" readonly="1"/>
                        </group>
                    </group>

                    <group>

                        <group string="Worksheet information">
                            <field name="arrival_time" required="1"/>
                            <field name="kilometers" required="1"/>
                            <field name="unit_of_measure" required="1"/>
                            <field name="return_date"/>
                            <field name="quantity_collected" required="1"/>
                            <field name="driver_signature" widget="signature" required="1"/>
                            <field name="service_provider_signature" string="Customer Signature" widget="signature" required="1"/>
                        </group>
                        <group string="Manifest Details">

                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   readonly="1"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   placeholder="Type to find a customer..."/>


                            <field name="hide_waste_type" invisible="1"/>
                            <field name="hide_waste_details" invisible="1"/>
                            <field name="hide_bin" invisible="1"/>
                            <field name="hide_tank" invisible="1"/>

                            <field name="service_requested_id" readonly="1"/>

                            <field name="waste_type_id" readonly="1"
                                   invisible="hide_waste_type == True"/>

                            <field name="waste_details_id" readonly="1"
                                   invisible="hide_waste_details == True"/>

                            <field name="bin_type_id" readonly="1"
                                   invisible="hide_tank == True and hide_bin == False"/>
                            <field name="container_type_id" readonly="1" widget="radio"
                                   options="{'horizontal': True}"/>


                            <field name="hide_droppoff_container_ids_placement" invisible="1"/>
                            <field name="hide_droppoff_container_ids_removal" invisible="1"/>
                            <field name="hide_droppoff_container_ids_collection" invisible="1"/>
                            <field name="hide_droppoff_container_ids_is_bin" invisible="1"/>


                            <!--                            <field name="pickup_point_id" readonly="state != 'draft'" invisible="0"/>-->
                            <field name="pickup_point_ids" readonly="1" widget="many2many_tags" invisible="0"/>
                            <field name="dropoff_container_ids" widget="many2many_tags" readonly="1"
                                   invisible="hide_droppoff_container_ids_placement == False or hide_tank == True"/>


                            <field name="dropoff_container_ids" widget="many2many_tags" readonly="1"
                                   invisible="hide_droppoff_container_ids_removal == False"
                                   required="1"/>


                            <field name="dropoff_container_ids" widget="many2many_tags" readonly="1"
                                   invisible="hide_droppoff_container_ids_collection == False or hide_droppoff_container_ids_is_bin == False "/>


                            <field name="hide_lifted_bin_ids_swap" invisible="1"/>
                            <field name="hide_dropped_bin_ids_swap" invisible="1"/>
                            <field name="hide_dropped_to_swap" invisible="1"/>
                            <!--  Swap  -->
                            <field name="lifted_bin_ids" widget="many2many_tags" readonly="1"
                                   invisible="hide_lifted_bin_ids_swap == False"/>

                            <field name="dropped_bin_ids" widget="many2many_tags" readonly="1"
                                   invisible="hide_dropped_to_swap == False"/>

                            <field name="pickup_point_id" invisible="hide_dropped_to_swap == False"
                                   readonly="1"/>

                            <field name="hide_shunt_container_ids" invisible="1"/>
                            <field name="hide_shunt_to_id" invisible="1"/>

                            <field name="shunt_container_ids" string="Bin Lifted" widget="many2many_tags"
                                   readonly="1"
                                   invisible="hide_shunt_container_ids == False"/>

                            <field name="shunt_to_id" string="Drop off Point" readonly="1"
                                   invisible="hide_shunt_to_id == False"/>

                            <field name="hide_tank_ids" invisible="1"/>
                            <field name="hide_tank_volume" invisible="1"/>
                            <field name="hide_liters_collected" invisible="1"/>
                            <field name="hide_liters_remaining" invisible="1"/>
                            <field name="hide_service_collection" invisible="1"/>


                            <field name="tank_ids" widget="many2many_tags"
                                   invisible="hide_tank_ids == False or hide_service_collection == False"
                                   readonly="1"

                            />
                            <field name="tank_volume_id" readonly="0"
                                   invisible="hide_tank_volume == False or hide_service_collection == False"/>
                            <field name="liters_collected" readonly="1"
                                   invisible="hide_liters_collected == False or hide_service_collection == False"/>
                            <field name="liters_remaining" readonly="1"
                                   invisible="hide_liters_remaining == False or hide_service_collection == False"/>
                            <field name="product_uom_qty" string="Bin no." readonly="1"/>
                            <field name="planned_date" string="Planned Date" readonly="1"/>


                        </group>
                    </group>
                    <separetor string="Upload information"/>
                    <group>
                        <group style="display:flex; align-items:center;">
                            <field name="manifest_document" filename="manifest_document_filename"
                                   style="flex:1;"/>
                            <button name="action_open_manifest_document"
                                    type="object"
                                    icon="fa-file-pdf-o"
                                    class="btn-sm"
                                    invisible="manifest_document == False"
                                    style="margin-left: -10px;"/>

                        </group>

                        <group style="display:flex; align-items:center;">
                            <field name="weighbridge_slip" invisible="hide_waste_type == True"
                                   filename="weighbridge_slip_filename"
                                   style="flex:1;"/>
                            <button name="action_open_weighbridge_slip"
                                    type="object"
                                    icon="fa-file-pdf-o"
                                    class="btn-sm"
                                    string="Upload"
                                    invisible="weighbridge_slip == False"
                                    style="margin-left: -10px;"/>

                        </group>


                        <group style="display:flex; align-items:center;" invisible="waste_type_id != 'hazardous'">
                            <field name="safety_certificate" filename="safety_certificate_filename"
                                   style="flex:1;"/>
                            <button name="action_open_safety_certificate"
                                    type="object"
                                    class="btn-sm"
                                    icon="fa-file-pdf-o"
                                    invisible="safety_certificate == False"
                                    style="margin-left: -10px;"/>

                        </group>
                    </group>

                    <notebook>
                        <page string="Photos">
                            <field name="image_ids" mode="kanban">
                                <kanban create="true" quick_create="false" class="o_kanban_large_column">
                                    <field name="image"/>
                                    <field name="name"/>

                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click o_kanban_card" style="padding: 6px;">
                                                <!-- Image block with fixed height -->
                                                <div style="
                            height: 220px;
                            overflow: hidden;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                        ">
                                                    <img t-att-src="kanban_image('waste.worksheet.image', 'image', record.id.value)"
                                                         style="
                                     width: 100%;
                                     height: 100%;
                                     object-fit: cover;
                                 "/>
                                                </div>

                                                <!-- Caption / description -->
                                                <div class="oe_kanban_details o_kanban_record_title"
                                                     style="margin-top: 4px;">
                                                    <strong>
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Notes &amp; Photos (HTML)">
                            <field name="notes_html"
                                   widget="html"
                                   options="{'toolbar': ['bold', 'italic', 'underline', 'image', 'link', 'ul', 'ol']}"/>
                        </page>

                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_waste_worksheet" model="ir.actions.act_window">
        <field name="name">Waste Worksheet</field>
        <field name="res_model">waste.worksheet</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
