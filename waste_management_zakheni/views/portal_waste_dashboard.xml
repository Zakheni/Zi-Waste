<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard page -->
    <template id="portal_waste_dashboard" name="Waste Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/my">
                            <span>
                                <i class="fa fa-home"/>
                                My Account
                            </span>
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        <span>Waste Dashboard</span>
                    </li>
                </ol>
            </t>

            <div class="o_portal_wrap">

                <!-- ================================================= -->
                <!-- Inline styles for KPIs + smaller charts -->
                <!-- ================================================= -->
                <style>
                    /* KPI merged container */
                    .wmz-kpi-wrap{
                    background: #f8f9fa;
                    border: 1px solid rgba(0,0,0,.06);
                    border-radius: 14px;
                    padding: 10px;
                    margin-top: 10px;
                    }
                    .wmz-kpi-item{
                    background: #fff;
                    border: 1px solid rgba(0,0,0,.06);
                    border-radius: 12px;
                    padding: 10px 10px;
                    height: 100%;
                    transition: transform .12s ease, box-shadow .12s ease;
                    text-decoration: none;
                    color: inherit;
                    display: block;
                    }
                    .wmz-kpi-item:hover{
                    transform: translateY(-1px);
                    box-shadow: 0 8px 16px rgba(0,0,0,.08);
                    }
                    .wmz-kpi-label{ font-size: 12px; color: #6c757d; }
                    .wmz-kpi-value{ font-size: 22px; font-weight: 700; line-height: 1.1; }
                    .wmz-kpi-icon{
                    width: 34px; height: 34px;
                    display:flex; align-items:center; justify-content:center;
                    border-radius: 999px;
                    background: rgba(0,0,0,.04);
                    }

                    /* Make dashboard charts more compact */
                    .wmz-small-chart {
                    max-height: 180px;
                    }

                    .wmz-kpi-item,
                    .wmz-kpi-item:hover,
                    .wmz-kpi-item:focus,
                    .wmz-kpi-item:active {
                    text-decoration: none !important;
                    outline: none !important;
                    box-shadow: none;
                    }
                    .wmz-kpi-item:focus-visible {
                    outline: none !important;
                    }

                </style>

                <!-- MAIN DASHBOARD CARD -->
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body py-3">

                        <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                            <div>
                                <h3 class="mb-1">
                                    Waste Service Dashboard
                                    <t t-if="is_agent">
                                        <small class="text-muted">– Agent view</small>
                                    </t>
                                </h3>

                                <div class="d-flex flex-wrap gap-2">
                                    <a href="/my/waste/report" target="_blank" class="btn btn-outline-dark btn-sm">
                                        <i class="fa fa-print me-1"/>
                                        Print Report
                                    </a>
                                    <a href="/my/waste/requests" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-list me-1"/>
                                        View Requests
                                    </a>

                                    <t t-if="not is_agent">
                                        <a href="/my/waste/request/new" class="btn btn-primary btn-sm">
                                            <i class="fa fa-plus me-1"/>
                                            Log New Service Request
                                        </a>
                                    </t>
                                </div>

                                <p class="text-muted mb-0 small mt-2">
                                    Overview of your waste service requests, revenue and operational activity.
                                </p>
                            </div>
                        </div>

                        <!-- ================================================= -->
                        <!-- KPI tiles (RESTORED + CLICKABLE) -->
                        <!-- ================================================= -->
                        <div class="wmz-kpi-wrap">
                            <div class="row g-2">

                                <!-- Total Requests -->
                                <div class="col-6 col-md-3">
                                    <a class="wmz-kpi-item" href="/my/waste/requests">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="wmz-kpi-label">Total Requests</div>
                                                <div class="wmz-kpi-value">
                                                    <t t-esc="total_requests or 0"/>
                                                </div>
                                            </div>
                                            <div class="wmz-kpi-icon">
                                                <i class="fa fa-recycle text-secondary"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Open Requests -->
                                <div class="col-6 col-md-3">
                                    <a class="wmz-kpi-item" href="/my/waste/requests?state=open">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="wmz-kpi-label">Open Requests</div>
                                                <div class="wmz-kpi-value text-primary">
                                                    <t t-esc="open_requests or 0"/>
                                                </div>
                                            </div>
                                            <div class="wmz-kpi-icon" style="background: rgba(13,110,253,.10);">
                                                <i class="fa fa-clock-o text-primary"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Scheduled -->
                                <div class="col-6 col-md-3">
                                    <a class="wmz-kpi-item" href="/my/waste/requests?state=scheduled">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="wmz-kpi-label">Scheduled</div>
                                                <div class="wmz-kpi-value">
                                                    <t t-esc="scheduled_requests or 0"/>
                                                </div>
                                            </div>
                                            <div class="wmz-kpi-icon" style="background: rgba(13,202,240,.12);">
                                                <i class="fa fa-calendar text-info"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Dispatched -->
                                <div class="col-6 col-md-3">
                                    <a class="wmz-kpi-item" href="/my/waste/requests?state=dispatched">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="wmz-kpi-label">Dispatched</div>
                                                <div class="wmz-kpi-value">
                                                    <t t-esc="dispatched_requests or 0"/>
                                                </div>
                                            </div>
                                            <div class="wmz-kpi-icon" style="background: rgba(255,193,7,.16);">
                                                <i class="fa fa-truck text-warning"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Service Delivered -->
                                <div class="col-6 col-md-3">
                                    <a class="wmz-kpi-item" href="/my/waste/requests?state=service_delivered">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="wmz-kpi-label">Service Delivered</div>
                                                <div class="wmz-kpi-value">
                                                    <t t-esc="delivered_requests or 0"/>
                                                </div>
                                            </div>
                                            <div class="wmz-kpi-icon" style="background: rgba(13,202,240,.12);">
                                                <i class="fa fa-check-square-o text-info"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Completed -->
                                <div class="col-6 col-md-3">
                                    <a class="wmz-kpi-item" href="/my/waste/requests?state=done">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="wmz-kpi-label">Completed</div>
                                                <div class="wmz-kpi-value text-success">
                                                    <t t-esc="done_requests or 0"/>
                                                </div>
                                            </div>
                                            <div class="wmz-kpi-icon" style="background: rgba(25,135,84,.14);">
                                                <i class="fa fa-check text-success"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                                <!-- Cancelled -->
                                <div class="col-6 col-md-3">
                                    <a class="wmz-kpi-item" href="/my/waste/requests?state=cancelled">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="wmz-kpi-label">Cancelled</div>
                                                <div class="wmz-kpi-value text-danger">
                                                    <t t-esc="cancelled_requests or 0"/>
                                                </div>
                                            </div>
                                            <div class="wmz-kpi-icon" style="background: rgba(220,53,69,.14);">
                                                <i class="fa fa-times-circle text-danger"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>

                            </div>
                        </div>
                        <!-- /KPI -->
                    </div>
                </div>

                <!-- CHARTS + TRIPS ROW -->
                <div class="row g-3">
                    <!-- Revenue by Customer (Pie) -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0">Revenue by Customer</h5>
                                    <span class="badge bg-light text-muted small">
                                        Based on worksheets
                                    </span>
                                </div>
                                <hr class="mt-2 mb-3"/>
                                <canvas id="wmzRevenueByCustomer" height="130" class="w-100 wmz-small-chart"></canvas>
                                <t t-if="chart_labels_json == '[]'">
                                    <p class="text-muted small mt-2">
                                        No worksheet data available yet to compute revenue by customer.
                                    </p>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Bin collection vs Revenue (Bar) -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0">Bin Collection vs Revenue</h5>
                                    <span class="badge bg-light text-muted small">
                                        Quantity collected vs billing
                                    </span>
                                </div>
                                <hr class="mt-2 mb-3"/>
                                <canvas id="wmzBinsVsRevenue" height="180"></canvas>
                                <t t-if="chart_labels_json == '[]'">
                                    <p class="text-muted small mt-2">
                                        No worksheet data available yet to show collection vs revenue.
                                    </p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- ================================================= -->
                <!-- CLIENT REPORT TABLE (Manifest / SO / Invoice) -->
                <!-- ================================================= -->
                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0">Client Report</h5>
                            <span class="text-muted small">
                                Manifest • Sales Order • Invoice (with totals)
                            </span>
                        </div>
                        <hr class="mt-2 mb-3"/>

                        <!-- Filters -->
                        <form method="get" action="/my/waste" class="row g-2 mb-3">
                            <div class="col-12 col-md-3">
                                <label class="form-label small text-muted mb-1">Date (from)</label>
                                <input type="date" name="date_from" class="form-control form-control-sm"
                                       t-att-value="report_filters and report_filters.get('date_from') or ''"/>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label small text-muted mb-1">Date (to)</label>
                                <input type="date" name="date_to" class="form-control form-control-sm"
                                       t-att-value="report_filters and report_filters.get('date_to') or ''"/>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label small text-muted mb-1">Manifest No</label>
                                <input type="text" name="manifest_no" class="form-control form-control-sm"
                                       placeholder="e.g. MNF-0001"
                                       t-att-value="report_filters and report_filters.get('manifest_no') or ''"/>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label small text-muted mb-1">Sales Order No</label>
                                <input type="text" name="sale_order_no" class="form-control form-control-sm"
                                       placeholder="e.g. S00012"
                                       t-att-value="report_filters and report_filters.get('sale_order_no') or ''"/>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label small text-muted mb-1">Invoice No</label>
                                <input type="text" name="invoice_no" class="form-control form-control-sm"
                                       placeholder="e.g. INV/2025/0012"
                                       t-att-value="report_filters and report_filters.get('invoice_no') or ''"/>
                            </div>

                            <div class="col-12 d-flex gap-2 mt-1">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fa fa-filter me-1"/>
                                    Apply Filters
                                </button>
                                <a href="/my/waste" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-times me-1"/>
                                    Clear
                                </a>
                            </div>
                        </form>

                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Planned Date</th>
                                        <th>Manifest</th>
                                        <th>Sales Order</th>
                                        <th>Invoice Number</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="not report_rows">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-3">
                                                No records found for the selected filters.
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-foreach="report_rows" t-as="r">
                                        <tr>
                                            <td>
                                                <t t-esc="r.get('planned_date')"/>

                                            </td>
                                            <td>
                                                <t t-if="r.get('manifest')">
                                                    <t t-esc="r['manifest'].name"/>
                                                </t>
                                            </td>
                                            <td>
                                                <t t-if="r.get('sale_order')">
                                                    <t t-esc="r['sale_order'].name"/>
                                                </t>
                                            </td>
                                            <td>
                                                <t t-if="r.get('invoice')">
                                                    <t t-esc="r['invoice'].name"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="r.get('total') or 0.0"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Quick totals -->
                        <t t-if="report_rows">
                            <div class="d-flex justify-content-end mt-2">
                                <span class="text-muted me-2">Grand Total:</span>
                                <strong>
                                    <t t-esc="sum([x.get('total') or 0.0 for x in report_rows])"/>
                                </strong>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- DRIVER TRIPS LIST -->
                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0">Recent Driver Trips</h5>
                            <span class="text-muted small">
                                Latest completed worksheets linked to your requests.
                            </span>
                        </div>
                        <hr class="mt-2 mb-3"/>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Date / Arrival</th>
                                        <th scope="col">Driver / Service Provider</th>
                                        <th scope="col">Request</th>
                                        <th scope="col" class="text-end">Quantity</th>
                                        <th scope="col" class="text-end">Revenue</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-if="not driver_trips_rows">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-3">
                                                No trips found yet.
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-foreach="driver_trips_rows" t-as="trow">
                                        <tr>
                                            <td>
                                                <t t-esc="trow.get('arrival')"/>
                                            </td>
                                            <td>
                                                <t t-esc="trow.get('who') or '—'"/>
                                            </td>
                                            <td>
                                                <t t-esc="trow.get('request')"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="trow.get('qty') or 0.0"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="trow.get('revenue') or 0.0"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>



                <!-- CHART.JS + INIT SCRIPT -->
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                    // Inject arrays directly (no JSON.parse)
                    var labels =<t t-raw="chart_labels_json or '[]'"/>;
                    var revenueData =<t t-raw="chart_revenue_json or '[]'"/>;
                    var binsData =<t t-raw="chart_bins_json or '[]'"/>;

                    // ---- PIE ----
                    var ctxPie = document.getElementById('wmzRevenueByCustomer');
                    if (ctxPie &amp;&amp; typeof Chart !== 'undefined' &amp;&amp; labels.length) {
                    new Chart(ctxPie, {
                    type: 'pie',
                    data: { labels: labels, datasets: [{ data: revenueData }] },
                    options: { plugins: { legend: { position: 'bottom' } } }
                    });
                    }

                    // ---- BAR ----
                    var ctxBar = document.getElementById('wmzBinsVsRevenue');
                    if (ctxBar &amp;&amp; typeof Chart !== 'undefined' &amp;&amp; labels.length) {
                    new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                    labels: labels,
                    datasets: [
                    { label: 'Revenue', data: revenueData, yAxisID: 'y' },
                    { label: 'Bin Quantity', data: binsData, yAxisID: 'y1' }
                    ]
                    },
                    options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                    y: { beginAtZero: true, position: 'left' },
                    y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false } }
                    }
                    }
                    });
                    }
                    });
                </script>

                <div class="mt-4 mb-5">
                    <a href="/my/home" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"/>
                        Back to Requests
                    </a>
                </div>
            </div>
        </t>
    </template>


</odoo>


