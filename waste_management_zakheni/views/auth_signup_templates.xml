<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the actual signup fields template -->
    <template id="wmz_signup_fields_extend"
              inherit_id="auth_signup.fields">

        <xpath expr="." position="inside">

            <div class="mb-3">
                <label class="form-label">
                    Register as <span class="text-danger">*</span>
                </label>

                <div>
                    <label class="me-3">
                        <input type="radio"
                               name="wmz_portal_group"
                               value="customer"
                               required="required"/>
                        Customer
                    </label>

                    <label>
                        <input type="radio"
                               name="wmz_portal_group"
                               value="agent"
                               required="required"/>
                        Agent
                    </label>
                </div>
            </div>

        </xpath>

    </template>

</odoo>
