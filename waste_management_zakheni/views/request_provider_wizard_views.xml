<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waste_request_provider_wizard_form" model="ir.ui.view">
        <field name="name">waste.request.provider.wizard.form</field>
        <field name="model">waste.request.provider.wizard</field>
        <field name="arch" type="xml">
            <form string="Find Service Provider">
                <group>
                    <field name="request_id" invisible="1"/>
                </group>

                <group string="Search Criteria">
                    <field name="province"/>
                    <field name="city"/>
                    <field name="suburb"/>
                </group>

                <group string="Result / Override">
                    <field name="provider_id"/>
                </group>

                <footer>
                    <button name="action_search_provider"
                            type="object"
                            string="Search Provider"/>
                    <button name="action_apply_provider"
                            type="object"
                            string="Use This Provider"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>



