<!-- Report — Waste Dashboard Report Action -->
<odoo>


  <!-- PDF Report Action -->
  <!-- Views / records -->
    <record id="action_waste_dashboard_report_pdf" model="ir.actions.report">
    <field name="name">Waste Dashboard</field>
    <field name="model">waste.service.request</field>
    <field name="report_type">qweb-pdf</field>

    <!-- these must match your qweb template name -->
    <field name="report_name">waste_management_zakheni.report_waste_dashboard_pdf</field>
    <field name="report_file">waste_management_zakheni.report_waste_dashboard_pdf</field>

    <field name="print_report_name">'Waste Dashboard - %s' % (object.name or '')</field>

    <!-- optional: add to Print menu of manifests -->
    <!-- <field name="binding_model_id" ref="model_waste_service_request"/> -->
    <!-- <field name="binding_type">report</field> -->
  </record>




