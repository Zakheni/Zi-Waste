<?xml version="1.0" encoding="utf-8"?>
<!-- Wizard / popup — View Manifest Document Up Pop -->
<odoo>
    <!-- Manifest Document Popup -->
    <!-- Views / records -->
    <record id="view_manifest_document_up_pop" model="ir.ui.view">
        <field name="name">waste.worksheet.manifest.document.up.pop</field>
        <field name="model">waste.worksheet</field>
        <field name="arch" type="xml">
            <form string="Manifest Document" create="false" edit="false">
                <sheet>
                    <field name="manifest_document" widget="pdf_viewer" filename="manifest_document_filename"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
