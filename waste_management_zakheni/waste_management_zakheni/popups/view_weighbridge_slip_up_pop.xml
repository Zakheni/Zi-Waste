<?xml version="1.0" encoding="utf-8"?>
<!-- Wizard / popup — View Weighbridge Slip Up Pop -->
<odoo>
    <!-- Weighbridge Slip Popup -->
    <!-- Views / records -->
    <record id="view_weighbridge_slip_up_pop" model="ir.ui.view">
        <field name="name">waste.worksheet.weighbridge.slip.up_pop</field>
        <field name="model">waste.worksheet</field>
        <field name="arch" type="xml">
            <form string="Weighbridge Slip" create="false" edit="false">
                <sheet>
                    <field name="weighbridge_slip" widget="pdf_viewer" filename="weighbridge_slip_filename"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
