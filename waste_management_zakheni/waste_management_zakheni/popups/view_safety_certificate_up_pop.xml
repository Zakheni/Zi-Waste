<?xml version="1.0" encoding="utf-8"?>
<!-- Wizard / popup — View Safety Certificate Up Pop -->
<odoo>
    <!-- Safety Certificate Popup -->
    <!-- Views / records -->
    <record id="view_safety_certificate_up_pop" model="ir.ui.view">
        <field name="name">waste.worksheet.safety.certificate.up_pop</field>
        <field name="model">waste.worksheet</field>
        <field name="arch" type="xml">
            <form string="Safety Certificate" create="false" edit="false">
                <sheet>
                    <field name="safety_certificate" widget="pdf_viewer" filename="safety_certificate_filename"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
