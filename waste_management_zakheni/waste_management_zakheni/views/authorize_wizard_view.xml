<?xml version="1.0" encoding="utf-8"?>
<!-- Wizard / popup — Authorize Wizard View -->
<odoo>
    <!-- Authorise manifest wizard after service delivery -->
    <record id="view_authorize_wizard_form" model="ir.ui.view">
        <field name="name">authorize.wizard.form</field>
        <field name="model">authorize.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <group>
                    <!-- Hide completely -->
                    <field name="user_id" invisible="1" readonly="1"/>

                    <field name="finance_employee_id"
                           widget="many2one_avatar_user"
                           required="1"/>

                    <field name="finance_email" readonly="1"/>
                </group>

                <footer>
                    <button name="action_authorise"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
