<?xml version="1.0" encoding="utf-8"?>
<!-- Views — Res User View -->
<odoo>
    <!-- Views / records -->
    <record id="view_users_form_inherit_service" model="ir.ui.view">
        <field name="name">res.users.form.inherit.service</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet" position="after">
                <chatter/>
            </xpath>

            <!-- Add new tab inside notebook -->
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Audit Trail">
                    <field name="audit_message_ids" nolabel="1" readonly="1">
                        <tree string="Audit Trail" create="false" delete="false">
                            <field name="date"/>
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="body"/>
                        </tree>
                    </field>
                </page>
            </xpath>

             <xpath expr="//notebook" position="inside">


            </xpath>


        </field>


    </record>



    <record id="hide_create_employee_button" model="ir.ui.view">
    <field name="name">res.users.form.hide.create.employee</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="hr.res_users_view_form"/>
    <field name="arch" type="xml">

        <xpath expr="//button[@name='action_create_employee']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

    </field>
</record>

</odoo>

