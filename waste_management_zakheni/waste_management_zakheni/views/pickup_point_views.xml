<!-- Views — Pickup Point -->
<odoo>

    <record id="view_pickup_point_search" model="ir.ui.view">
        <field name="name">pickup.point.search</field>
        <field name="model">pickup.point</field>
        <field name="arch" type="xml">
            <search string="Pickup Points">
                <field name="name" string="Pickup Point"/>
                <field name="partner_id" string="Customer"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pickup_point_form" model="ir.ui.view">
        <field name="name">pickup.point.form</field>
        <field name="model">pickup.point</field>
        <field name="arch" type="xml">
            <form string="Pickup Point" class="o_wmz_pickup_point_form">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                class="oe_stat_button"
                                icon="fa-cube"
                                name="action_view_containers">
                            <field name="container_count" widget="statinfo" string="Containers"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="o_wmz_pp_header">
                        <div class="o_wmz_pp_title_block">
                            <span class="o_wmz_pp_icon" title="Pickup point">
                                <i class="fa fa-map-marker"/>
                            </span>
                            <div class="o_wmz_pp_title_text">
                                <span class="o_wmz_pp_eyebrow">Pickup point</span>
                                <h1 class="o_wmz_pp_name_field">
                                    <field name="name" placeholder="e.g. Main depot, Site A, Warehouse gate..."/>
                                </h1>
                            </div>
                        </div>
                        <div class="o_wmz_pp_summary" invisible="not partner_id">
                            <div class="o_wmz_pp_summary_item">
                                <span class="o_wmz_pp_summary_label">Customer</span>
                                <span class="o_wmz_pp_summary_value">
                                    <field name="partner_id" readonly="1" nolabel="1"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <group string="Location details" class="o_wmz_pp_details">
                        <group>
                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   options="{'no_open': True}"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   placeholder="Select customer company..."/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="created_from_portal" readonly="1" invisible="not created_from_portal"/>
                        </group>
                    </group>

                    <group string="Linked waste containers" class="o_wmz_pp_containers">
                        <field name="container_ids" nolabel="1" colspan="2" readonly="1">
                            <tree create="false" delete="false" edit="false">
                                <field name="name"/>
                                <field name="container_type_id" optional="show"/>
                                <field name="status" string="Condition" optional="show"/>
                            </tree>
                        </field>
                    </group>

                    <field name="sale_order_id" invisible="1"/>
                    <field name="service_request_id" invisible="1"/>
                    <field name="pickup_request_id" invisible="1"/>
                    <field name="dropoff_request_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_pickup_point_tree" model="ir.ui.view">
        <field name="name">pickup.point.tree</field>
        <field name="model">pickup.point</field>
        <field name="arch" type="xml">
            <tree default_order="name asc" decoration-muted="active == False">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="container_count" string="Containers"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_pickup_point_kanban" model="ir.ui.view">
        <field name="name">pickup.point.kanban</field>
        <field name="model">pickup.point</field>
        <field name="arch" type="xml">
            <kanban class="o_wmz_pickup_point_kanban" default_order="name asc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="container_count"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_wmz_pp_card" t-att-class="{'o_wmz_pp_card_archived': !record.active.raw_value}">
                            <div class="o_wmz_pp_card_banner">
                                <span class="o_wmz_pp_card_icon"><i class="fa fa-map-marker" title="Pickup point"/></span>
                                <div class="o_wmz_pp_card_title">
                                    <strong><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_wmz_pp_card_body">
                                <div t-if="record.partner_id.value" class="o_wmz_pp_card_row">
                                    <i class="fa fa-building-o" title="Customer"/>
                                    <span t-esc="record.partner_id.value"/>
                                </div>
                                <div class="o_wmz_pp_card_stat">
                                    <i class="fa fa-cube" title="Containers"/>
                                    <span><field name="container_count"/> container(s)</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_pickup_points" model="ir.actions.act_window">
        <field name="name">Pickup Points</field>
        <field name="res_model">pickup.point</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_pickup_point_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first pickup point
            </p>
            <p>
                Pickup points are customer sites where bins are placed, lifted, or tanks are serviced.
                Link each point to a <strong>company customer</strong> so manifests and worksheets stay organised.
            </p>
        </field>
    </record>

</odoo>
