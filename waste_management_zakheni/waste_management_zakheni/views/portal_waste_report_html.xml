<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_waste_report_html" name="Waste Portal Printable Report">
        <t t-call="portal.portal_layout">

            <t t-set="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/my">
                            <span>
                                <i class="fa fa-home"/>
                                My Account
                            </span>
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        <span>Waste Service Report</span>
                    </li>
                </ol>
            </t>

            <!-- SAFE DEFAULT -->
            <t t-set="filters" t-value="filters or {}"/>

            <div class="o_portal_wrap">

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <h2 class="mb-1">Waste Service Report</h2>
                        <p class="text-muted mb-0">
                            Generated for:
                            <t t-esc="user.name"/>
                        </p>

                        <div class="mt-3">
                            <a class="btn btn-outline-dark btn-sm me-2"
                               t-att-href="'/my/waste/report/pdf?date_from=%s&amp;date_to=%s&amp;manifest_no=%s&amp;sale_order_no=%s&amp;invoice_no=%s' % (
                                   (filters.get('date_from') or ''),
                                   (filters.get('date_to') or ''),
                                   (filters.get('manifest_no') or ''),
                                   (filters.get('sale_order_no') or ''),
                                   (filters.get('invoice_no') or '')
                               )">
                                <i class="fa fa-file-pdf-o me-1"/>
                                Download PDF
                            </a>

                            <a class="btn btn-outline-success btn-sm"
                               t-att-href="'/my/waste/report/xlsx?date_from=%s&amp;date_to=%s&amp;manifest_no=%s&amp;sale_order_no=%s&amp;invoice_no=%s' % (
                                   (filters.get('date_from') or ''),
                                   (filters.get('date_to') or ''),
                                   (filters.get('manifest_no') or ''),
                                   (filters.get('sale_order_no') or ''),
                                   (filters.get('invoice_no') or '')
                               )">
                                <i class="fa fa-file-excel-o me-1"/>
                                Export to Excel
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Client Report -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <h4 class="mb-2">Client Report</h4>
                        <hr class="mt-1 mb-3"/>

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Planned Date</th>
                                        <th>Manifest</th>
                                        <th>Sales Order</th>
                                        <th>Invoice Number</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="not rows">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-3">
                                                No data found for the selected filters.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="rows" t-as="r">
                                        <tr>
                                            <td>
                                                <t t-esc="r.get('planned_date') or ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="r.get('manifest') or ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="r.get('sale_order') or ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="r.get('invoice') or ''"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="r.get('total') or 0.0"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Driver Trips -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <h4 class="mb-2">Recent Driver Trips</h4>
                        <hr class="mt-1 mb-3"/>

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Arrival</th>
                                        <th>Return</th>
                                        <th>Planned</th>
                                        <th>Manifest</th>
                                        <th>Driver</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="not recent_trips_rows">
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-3">No recent trips found.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="recent_trips_rows" t-as="trow">
                                        <tr>
                                            <td>
                                                <t t-esc="trow.get('arrival')"/>
                                            </td>
                                            <td>
                                                <t t-esc="trow.get('return')"/>
                                            </td>
                                            <td>
                                                <t t-esc="trow.get('planned')"/>
                                            </td>
                                            <td>
                                                <t t-esc="trow.get('manifest')"/>
                                            </td>
                                            <td>
                                                <t t-esc="trow.get('driver')"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="trow.get('qty')"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="trow.get('revenue')"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


                <div class="mt-4 mb-5">
                    <a href="/my/waste" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"/>
                        Back
                    </a>
                </div>

            </div>
        </t>
    </template>

</odoo>


