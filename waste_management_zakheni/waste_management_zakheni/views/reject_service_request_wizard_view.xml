<?xml version="1.0" encoding="utf-8"?>
<!-- Wizard / popup — Reject Service Request Wizard View -->
<odoo>
    <!-- Reject manifest wizard with reason -->
    <record id="view_reject_service_request_wizard_form" model="ir.ui.view">
        <field name="name">reject.service.request.wizard.form</field>
        <field name="model">reject.service.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Reject Reason">
                <group>
                    <field name="reject_reason"/>
                    <field name="user_id" invisible="1"/>

                    <field name="employee_email_id"
                           widget="many2one_avatar_user"
                           options="{'no_open': True}"
                           required="1"/>
                    <field name="admin_clerck_email" readonly="1"/>
                </group>
                <footer>
                    <button name="action_submit_reject_reason"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
