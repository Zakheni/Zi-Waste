<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reject_service_request_wizard_form" model="ir.ui.view">
        <field name="name">reject.service.request.wizard.form</field>
        <field name="model">reject.service.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Reject Reason">
                <group>
                    <field name="reject_reason"/>
                    <field name="user_id" invisible="1"/>
                </group>
                <group>
                    <footer>
                        <button name="action_submit_reject_reason"
                                string="Submit"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>

                </group>
            </form>
        </field>
    </record>
</odoo>
