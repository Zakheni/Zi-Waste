<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wmz_user_password_wizard_form" model="ir.ui.view">
        <field name="name">wmz.user.password.wizard.form</field>
        <field name="model">wmz.user.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Change User Password">
                <group>
                    <field name="provision_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                    <field name="login"/>
                    <field name="send_reset_email"/>
                </group>
                <group invisible="send_reset_email">
                    <field name="new_password" password="True"/>
                    <field name="confirm_password" password="True"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
