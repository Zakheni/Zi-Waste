<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wms_service_provider_tree" model="ir.ui.view">
        <field name="name">wms.service.provider.tree</field>
        <field name="model">wms.service.provider</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="province"/>
                <field name="city"/>
                <field name="suburb"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="number_of_fleet"/>
                <field name="fleet_category_list"/>
            </tree>
        </field>
    </record>

    <record id="view_wms_service_provider_form" model="ir.ui.view">
        <field name="name">wms.service.provider.form</field>
        <field name="model">wms.service.provider</field>
        <field name="arch" type="xml">
            <form string="Service Provider">
                <header>
                    <button name="action_open_find_wizard"
                            type="object"
                            string="Find Provider"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="street" placeholder="Street address"/>
                            <field name="suburb" required="1"/>
                            <field name="city" string="City/Town" required="1"/>
                            <field name="province" required="1"/>
                        </group>
                        <group>
                            <field name="phone" required="1"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="agent" widget="many2one_avatar_user"/>



                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="number_of_fleet"/>
                            <field name="fleet_category_ids" widget="many2many_tags"
                                   placeholder="Select categories from Fleet module"/>
                            <field name="fleet_category_list" readonly="1"/>
                        </group>
                        <group string="Optional Geo (for closest matching)">
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="company_id"/>

                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_wms_service_provider_search" model="ir.ui.view">
        <field name="name">wms.service.provider.search</field>
        <field name="model">wms.service.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="province_wc" string="Western Cape" domain="[('province','=','WC')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_province" string="Province" context="{'group_by':'province'}"/>
                    <filter name="group_city" string="City/Town" context="{'group_by':'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wms_service_provider" model="ir.actions.act_window">
        <field name="name">Service Providers</field>
        <field name="res_model">wms.service.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_wms_service_provider_search"/>
    </record>


</odoo>

