<?xml version="1.0" encoding="utf-8"?>
<!-- Portal — Branded invoice detail UI -->
<odoo>

    <!-- ================================================================
         INVOICE DETAIL — /my/invoices/<id>
         ================================================================ -->
    <template id="wmz_portal_invoice_detail"
              inherit_id="account.portal_invoice_page"
              name="WMZ Portal Invoice Detail"
              priority="30">

        <xpath expr="//t[@t-call='portal.portal_layout']" position="before">
            <t t-set="no_breadcrumbs" t-value="True"/>
        </xpath>

        <xpath expr="//div[hasclass('o_portal_invoice_sidebar')]" position="attributes">
            <attribute name="class" add="wmz-portal wmz-portal-invoice-detail" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='invoice_content']" position="attributes">
            <attribute name="class" add="wmz-portal-invoice-main" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_portal_html_view')]" position="before">
            <nav aria-label="breadcrumb" class="wmz-portal-breadcrumb mb-3 d-print-none">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/my/home"><i class="fa fa-home"/></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/my/invoices?filterby=invoices">Invoices &amp; Bills</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <t t-if="invoice.name != '/'" t-out="invoice.name"/>
                        <t t-else=""><em>Draft Invoice</em></t>
                    </li>
                </ol>
            </nav>
            <t t-set="sale_order"
               t-value="request.env['sale.order'].sudo().search([('name', '=', invoice.invoice_origin)], limit=1)"/>
            <div class="wmz-portal-hero wmz-portal-invoice-hero wmz-detail-hero mb-4 d-print-none">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <p class="wmz-detail-hero_kicker mb-1">
                            <t t-if="invoice.move_type == 'out_invoice'">Customer Invoice</t>
                            <t t-elif="invoice.move_type == 'in_invoice'">Vendor Bill</t>
                            <t t-else="">Invoice</t>
                        </p>
                        <h1 class="wmz-portal-hero_title mb-2">
                            <t t-if="invoice.name != '/'" t-out="invoice.name"/>
                            <t t-else=""><em>Draft Invoice</em></t>
                        </h1>
                        <div class="wmz-detail-hero_meta">
                            <span t-if="invoice.invoice_date" class="me-3">
                                <i class="fa fa-calendar me-1"/>
                                <span t-field="invoice.invoice_date" t-options="{'widget': 'date'}"/>
                            </span>
                            <span t-if="invoice.invoice_date_due" class="me-3">
                                <i class="fa fa-clock-o me-1"/>
                                Due:
                                <span t-field="invoice.invoice_date_due" t-options="{'widget': 'date'}"/>
                            </span>
                            <span t-if="sale_order and sale_order.service_request_id">
                                <i class="fa fa-file-text-o me-1"/>
                                Manifest:
                                <t t-out="sale_order.service_request_id.display_name"/>
                            </span>
                        </div>
                    </div>
                    <span t-if="invoice.state == 'posted'"
                          t-attf-class="wmz-badge wmz-badge-lg #{invoice.payment_state in ('paid', 'in_payment', 'reversed') and 'wmz-badge-done' or 'wmz-badge-progress'}">
                        <t t-if="invoice.payment_state in ('paid', 'in_payment')">Paid</t>
                        <t t-elif="invoice.payment_state == 'reversed'">Reversed</t>
                        <t t-else="">Waiting for Payment</t>
                    </span>
                    <span t-elif="invoice.state == 'cancel'"
                          class="wmz-badge wmz-badge-lg wmz-badge-cancelled">
                        Cancelled
                    </span>
                    <span t-else=""
                          class="wmz-badge wmz-badge-lg wmz-badge-draft">
                        Draft
                    </span>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('o_portal_html_view')]" position="attributes">
            <attribute name="class" add="wmz-portal-invoice-preview" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='invoice_communication']" position="attributes">
            <attribute name="class" add="wmz-portal-invoice-communication" separator=" "/>
        </xpath>

    </template>

    <template id="portal_invoice_manifest"
              inherit_id="account.portal_invoice_page"
              priority="20">

        <xpath expr="//div[@class='o_portal_contact_details d-flex flex-column gap-2']"
               position="after">

            <div class="mt-3 wmz-portal-invoice-sidebar-manifest">

                <h6>
                    <small class="text-muted">
                        Manifest
                    </small>
                </h6>

                <t t-set="sale_order"
                   t-value="request.env['sale.order'].sudo().search([('name', '=', invoice.invoice_origin)], limit=1)"/>

                <div>
                    <span t-if="sale_order and sale_order.service_request_id"
                          t-field="sale_order.service_request_id"/>
                    <span t-else="">-</span>
                </div>

            </div>

        </xpath>

    </template>

</odoo>
