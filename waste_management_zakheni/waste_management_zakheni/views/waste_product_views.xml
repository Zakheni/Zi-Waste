<!-- Views — Waste Product Views -->
<odoo>
    <!-- Views / records -->
    <record id="view_product_waste_kanban" model="ir.ui.view">
        <field name="name">product.template.waste.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">

            <kanban class="o_kanban_small_column" create="false">
                <field name="waste_qty"/>
                <field name="waste_selected"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-att-class="'oe_kanban_card ' + (record.waste_qty.value &gt; 0 and 'o_waste_selected' or '')"
                             t-att-style="record.waste_qty.value &gt; 0 and 'background-color:#e6ffe6;border:1px solid #28a745;' or ''">


                            <div class="o_kanban_image">
                                <!-- on v15+ image_1920 is common; if yours is image_128 keep as is -->
                                <field name="image_128" widget="image"/>
                            </div>
                            <div class="o_kanban_details">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <br/>
                                <span t-if="record.default_code.value">
                                    [<field name="default_code"/>]
                                </span>
                                <br/>
                                <span>Unit price:</span>
                                <field name="list_price"/>
                            </div>

                            <div class="mt-2 d-flex justify-content-between align-items-center">
                                <!-- – button -->
                                <button type="object"
                                        name="action_waste_remove_one"
                                        class="btn btn-secondary btn-sm oe_kanban_action oe_kanban_action_button">
                                    <i class="fa fa-minus"/>
                                </button>

                                <!-- Qty badge / 0 label -->
                                <t t-if="record.waste_qty.value">
                                    <span class="badge badge-primary mx-2">
                                        Qty:
                                        <t t-esc="record.waste_qty.value"/>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="mx-2 text-muted">Qty: 0</span>
                                </t>

                                <!-- + button -->
                                <button type="object"
                                        name="action_waste_add_one"
                                        class="btn btn-secondary btn-sm oe_kanban_action oe_kanban_action_button">
                                    <i class="fa fa-plus"/>
                                </button>

                                <!-- Add button -->
                                <button type="object"
                                        name="action_waste_add_one"
                                        class="btn btn-primary btn-sm ml-2 oe_kanban_action oe_kanban_action_button">
                                    <i class="fa fa-shopping-cart"/>
                                    Add
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>


        </field>
    </record>



    <record id="action_waste_request_product_selector" model="ir.actions.act_window">
        <field name="name">Select Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_product_waste_kanban"/>
        <field name="target">current</field>
    </record>
</odoo>


