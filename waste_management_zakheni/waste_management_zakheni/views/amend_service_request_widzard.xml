<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amend_service_request_wizard_form" model="ir.ui.view">
        <field name="name">amend.service.request.wizard.form</field>
        <field name="model">amend.service.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Reject Reason">
                <group>
                    <field name="amend_comment" required="1"/>
                    <field name="user_id" invisible="1"/>
                     <field name="employee_manager_id" widget="many2one_avatar_user" required="1"/>-->
                    <field name="manager_email" readonly="1"/>
                </group>
                <group>
                    <footer>
                        <button name="action_submit_amend_comment"
                                string="Submit"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>

                </group>
            </form>
        </field>
    </record>
</odoo>
