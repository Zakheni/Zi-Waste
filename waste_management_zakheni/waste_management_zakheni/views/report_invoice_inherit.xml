<?xml version="1.0" encoding="UTF-8"?>
<!-- Views — Report Invoice Inherit -->
<odoo>

    <template
            id="report_invoice_title"
            inherit_id="account.report_invoice_document">

        <xpath expr="//h2" position="replace">

            <h2>

                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                    Invoice
                </span>

                <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                    Draft Invoice
                </span>

                <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                    Cancelled Invoice
                </span>

                <span t-elif="o.move_type == 'out_refund'">
                    Credit Note
                </span>

                <span t-elif="o.move_type == 'in_invoice'">
                    Vendor Bill
                </span>

                <span t-if="o.name != '/'" t-field="o.name"/>

            </h2>

        </xpath>

    </template>

    <!-- Add Manifest -->
    <template id="report_invoice_manifest"
              inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='informations']" position="inside">

            <t t-set="sale_order"
               t-value="env['sale.order'].search([('name', '=', o.invoice_origin)], limit=1)"/>

            <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                 t-if="sale_order">

                <strong>Manifest:</strong>
                <br/>

                <span t-if="sale_order.service_request_id"
                      t-field="sale_order.service_request_id"/>

            </div>

        </xpath>

    </template>

</odoo>