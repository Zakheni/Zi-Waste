<?xml version="1.0" encoding="utf-8"?>
<!-- Security — Waste Portal Access -->
<odoo>

    <!-- ===========================
         waste.service.request
         =========================== -->

    <!-- Customer: can create + read ONLY (no edit/delete) -->
    <record id="access_wsr_portal_customer" model="ir.model.access">
        <field name="name">wsr.portal.customer</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="group_id" ref="waste_management_zakheni.group_wmz_client_customer"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Agent: can read service requests -->
    <record id="access_wsr_portal_agent" model="ir.model.access">
        <field name="name">wsr.portal.agent</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="group_id" ref="waste_management_zakheni.group_wmz_client_agent"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


    <!-- ===========================
         waste.worksheet
         =========================== -->

    <!-- Agent: can read + edit + create worksheet -->
    <record id="access_ws_portal_agent" model="ir.model.access">
        <field name="name">ws.portal.agent</field>
        <field name="model_id" ref="model_waste_worksheet"/>
        <field name="group_id" ref="waste_management_zakheni.group_wmz_client_agent"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
