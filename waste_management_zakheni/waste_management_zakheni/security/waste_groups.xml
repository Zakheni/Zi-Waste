    </record>

    <record id="group_wmz_customer_access" model="res.groups">
        <field name="name">Customer Access</field>
        <field name="category_id" ref="waste_management_zakheni.module_category_waste_management"/>
    </record>


    <record id="menu_custom_company" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [
               ref('waste_management_zakheni.group_wmz_customer_access')
           ])]"/>
    </record>

    <record id="group_wmz_user_manager" model="res.groups">
        <field name="name">User Manager</field>
        <field name="category_id" ref="waste_management_zakheni.module_category_waste_management"/>
