<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admin: own records OR from portal -->
    <record id="wmz_rule_manifest_admin" model="ir.rule">
        <field name="name">Manifest: Admin</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin'))]"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    </record>


    <!-- Admin Clerk -->
    <record id="wmz_rule_manifest_admin_clerk" model="ir.rule">
        <field name="name">Manifest: Admin Clerk (by company)</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin_clerk'))]"/>

        <field name="domain_force">
            [
            ('from_portal', '=', True),
            ('company_id', '=', user.company_id.id)
            ]
        </field>

    </record>

    <record id="wmz_rule_admin_clerk_own_records" model="ir.rule">
        <field name="name">Manifest: Admin Clerk - Own records</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin_clerk'))]"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            [
            ('create_uid', '=', user.id)
            ]
        </field>
    </record>


    <!-- Manager: own records OR from portal -->
    <!-- Manager: own-company records in selected states (portal + internal) -->
    <record id="wmz_rule_manifest_manager" model="ir.rule">
        <field name="name">Manifest: Manager (company + delivered/done/cancelled)</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_manager'))]"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            [
            ('company_id', '=', user.company_id.id),
            ('state', 'in', ['generated', 'scheduled', 'dispatched', 'service_delivered', 'done', 'cancelled'])
            ]
        </field>
    </record>


    <record id="wmz_rule_manifest_finance" model="ir.rule">
        <field name="name">Manifest: Finance (Done - Own Company)</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_finance'))]"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            [
            ('company_id', '=', user.company_id.id),
            ('state', 'in', ['generated', 'scheduled', 'dispatched', 'service_delivered', 'done', 'cancelled'])
            ]
        </field>
    </record>

    <!-- Driver: state in X OR from portal -->
    <record id="wmz_rule_manifest_driver" model="ir.rule">
        <field name="name">Manifest: Driver</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_driver'))]"/>
        <field name="domain_force">
            [
            ('state', 'in', ['scheduled', 'dispatched', 'service_delivered']),
            ('company_id', '=', user.company_id.id),
            ]
        </field>
    </record>

    <record id="rule_sale_order_wmz_manager_company" model="ir.rule">
        <field name="name">Sale Order: WMZ Manager - Allowed Companies</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_manager'))]"/>
        <field name="global" eval="False"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>

    <!-- Manager: Read / Write Fleet Vehicles WITHOUT Fleet app -->
    <record id="access_fleet_vehicle_manager" model="ir.model.access">
        <field name="name">fleet.vehicle manager access</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="group_id" ref="waste_management_zakheni.group_wmz_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="waste_container_multi_company_rule" model="ir.rule">
        <field name="name">Waste Container: multi-company access</field>
        <field name="model_id" ref="model_waste_container"/>
        <field name="domain_force">
            [('company_id', 'in', user.company_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>


