        <field name="name">Central Admin - Allowed Companies Only</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_central_admin'))]"/>
        <field name="global" eval="False"/>
