<?xml version="1.0" encoding="utf-8"?>
<!-- Security — Portal client groups (website / portal users, not backend staff) -->
<odoo>

    <record id="module_category_wmz_client" model="ir.module.category">
        <field name="name">Client Portal</field>
        <field name="description">Portal-only access for external clients. These users log in via the website portal — not the internal backend. Do not combine with Internal User or Company Administrator.</field>
        <field name="sequence">26</field>
        <field name="visible" eval="True"/>
        <field name="exclusive" eval="True"/>
    </record>

    <record id="group_wmz_client_customer" model="res.groups">
        <field name="name">Portal Customer</field>
        <field name="category_id" ref="waste_management_zakheni.module_category_wmz_client"/>
        <field name="comment">External customer who submits and tracks their own waste service requests via the portal.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_wmz_client_agent" model="res.groups">
        <field name="name">Portal Agent</field>
        <field name="category_id" ref="waste_management_zakheni.module_category_wmz_client"/>
        <field name="comment">Client-side agent who manages service requests on behalf of a customer company via the portal.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

</odoo>
