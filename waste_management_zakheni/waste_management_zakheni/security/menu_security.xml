<?xml version="1.0" encoding="utf-8"?>
<!-- Security — Menu Security -->
<odoo>
    <data>
        <record id="mail.menu_root_discuss" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>

        <!-- Restrict Apps menu to System Admin only -->
        <record id="base.menu_management" model="ir.ui.menu">
            <field name="groups_id"
                   eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>


        <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
            <field name="groups_id"
                   eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>


        <record id="base.menu_action_res_company_form"
                model="ir.ui.menu">
            <field name="groups_id"
                   eval="[
                   Command.set([
                       ref('base.group_system'),
                       ref('waste_management_zakheni.group_central_admin'),
                       ref('waste_management_zakheni.group_company_admin'),
                   ])
               ]"/>
        </record>


        <!-- =========================
             DRIVER RESTRICTIONS
             Driver users must not see dashboard, sales, invoicing,
             employees, or inventory root app menus.
             ========================= -->

        <record id="menu_waste_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('waste_management_zakheni.group_wmz_admin'),
                ref('waste_management_zakheni.group_wmz_admin_clerk'),
                ref('waste_management_zakheni.group_wmz_manager'),
                ref('waste_management_zakheni.group_wmz_finance'),
            ])]"/>
        </record>

        <record id="menu_waste_dashboard" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('waste_management_zakheni.group_wmz_admin'),
                ref('waste_management_zakheni.group_wmz_admin_clerk'),
                ref('waste_management_zakheni.group_wmz_manager'),
                ref('waste_management_zakheni.group_wmz_finance'),
            ])]"/>
        </record>

        <!-- Drivers: Waste Management + Vehicle Inspections apps in the app switcher -->
        <record id="menu_pickup_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('waste_management_zakheni.group_wmz_admin'),
                ref('waste_management_zakheni.group_wmz_admin_clerk'),
                ref('waste_management_zakheni.group_wmz_manager'),
                ref('waste_management_zakheni.group_wmz_finance'),
                ref('waste_management_zakheni.group_wmz_driver'),
                ref('waste_management_zakheni.group_company_admin'),
                ref('waste_management_zakheni.group_central_admin'),
                ref('waste_management_zakheni.group_wmz_user_manager'),
            ])]"/>
        </record>

        <record id="vehicle_inspection.menu_vehicle_inspection_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('vehicle_inspection.group_vehicle_inspection_user'),
                ref('vehicle_inspection.group_vehicle_inspection_manager'),
            ])]"/>
        </record>

        <record id="vehicle_inspection.menu_vehicle_inspection" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('vehicle_inspection.group_vehicle_inspection_user'),
                ref('vehicle_inspection.group_vehicle_inspection_manager'),
            ])]"/>
        </record>

        <record id="vehicle_inspection.menu_inspection_category" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('vehicle_inspection.group_vehicle_inspection_manager'),
            ])]"/>
        </record>

        <record id="vehicle_inspection.menu_inspection_item" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('vehicle_inspection.group_vehicle_inspection_manager'),
            ])]"/>
        </record>

        <record id="menu_waste_worksheet" model="ir.ui.menu">
            <field name="name">Worksheet</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('waste_management_zakheni.group_wmz_driver'),
                ref('waste_management_zakheni.group_wmz_admin'),
                ref('waste_management_zakheni.group_wmz_admin_clerk'),
                ref('waste_management_zakheni.group_wmz_manager'),
                ref('waste_management_zakheni.group_wmz_finance'),
                ref('waste_management_zakheni.group_company_admin'),
                ref('waste_management_zakheni.group_central_admin'),
            ])]"/>
        </record>

        <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_system'),
                ref('waste_management_zakheni.group_wmz_admin'),
                ref('waste_management_zakheni.group_wmz_manager'),
            ])]"/>
        </record>

        <!-- =========================
       SALES MODULE
       ========================= -->

        <record id="sale.sale_menu_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6,0,[
                        ref('waste_management_zakheni.group_wmz_admin'),
                        ref('waste_management_zakheni.group_wmz_admin_clerk'),
                        ref('waste_management_zakheni.group_wmz_finance'),
                        ref('waste_management_zakheni.group_wmz_manager'),
                        ref('waste_management_zakheni.group_company_admin'),
                        ref('waste_management_zakheni.group_central_admin'),
                    ])]"/>
        </record>

        <!-- =========================
        INVOICING / ACCOUNTING
        ========================= -->
        <!-- Root Accounting/Invoices app menu -->
        <record id="account.menu_finance" model="ir.ui.menu">
            <field name="groups_id" eval="[(6,0,[
                        ref('waste_management_zakheni.group_wmz_admin'),
                        ref('waste_management_zakheni.group_wmz_finance'),
                      ])]"/>
        </record>


        <!-- =========================
             EMPLOYEES (HR)
             ========================= -->
        <!-- Root Employees app menu -->
        <record id="hr.menu_hr_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6,0,[
                        ref('waste_management_zakheni.group_wmz_admin'),
                        ref('waste_management_zakheni.group_wmz_manager')
                      ])]"/>
        </record>

        <!-- Fleet app — requires Odoo Fleet security groups -->
        <record id="fleet.menu_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                ref('fleet.fleet_group_user'),
                ref('fleet.fleet_group_manager'),
            ])]"/>
        </record>

        <record id="contacts.menu_contacts" model="ir.ui.menu">
            <field name="groups_id"
                   eval="[(6, 0, [
                        ref('waste_management_zakheni.group_wmz_admin'),
                        ref('waste_management_zakheni.group_company_admin'),
                        ref('waste_management_zakheni.group_wmz_user_manager'),
                   ])]"/>
        </record>


        <!-- =========================
             INVENTORY (STOCK)
             ========================= -->
        <!-- Root Inventory app menu -->
        <record id="stock.menu_stock_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(6,0,[
                        ref('waste_management_zakheni.group_wmz_admin'),
                        ref('waste_management_zakheni.group_wmz_finance'),

                      ])]"/>
        </record>


        <record id="base.menu_administration" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),
                    ref('base.group_erp_manager')
                ])]"/>
        </record>


        <!-- To invoice menu -->
        <record id="sale.menu_sale_invoicing" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),
                    ref('base.group_erp_manager'),
                    ref('waste_management_zakheni.group_wmz_admin'),
                    ref('waste_management_zakheni.group_wmz_finance'),
                    ref('waste_management_zakheni.group_wmz_manager')
                ])]"/>
        </record>

        <!-- Hide Products menu -->
        <record id="sale.product_menu_catalog" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),
                    ref('base.group_erp_manager'),
                    ref('waste_management_zakheni.group_wmz_admin'),
                    ref('waste_management_zakheni.group_wmz_finance'),
                ])]"/>
        </record>

        <!-- Hide Reporting menu -->
        <record id="sale.menu_sale_report" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),
                    ref('base.group_erp_manager'),
                    ref('waste_management_zakheni.group_wmz_admin'),
                    ref('waste_management_zakheni.group_wmz_finance'),
                ])]"/>
        </record>

        <!-- Hide Configuration menu -->
        <record id="sale.menu_sale_config" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),
                    ref('base.group_erp_manager'),
                    ref('waste_management_zakheni.group_wmz_admin'),
                    ref('waste_management_zakheni.group_wmz_finance'),
                    ref('waste_management_zakheni.group_company_admin'),
                    ref('waste_management_zakheni.group_central_admin'),
                ])]"/>
        </record>

        <!-- Online Payments under Sales → Configuration (not Settings-only) -->
        <record id="sale.payment_menu" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),
                    ref('waste_management_zakheni.group_wmz_admin'),
                    ref('waste_management_zakheni.group_wmz_finance'),
                    ref('waste_management_zakheni.group_company_admin'),
                    ref('waste_management_zakheni.group_central_admin'),
                ])]"/>
        </record>

        <!-- Hide Configuration menu -->
        <record id="base.menu_custom" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),

                ])]"/>
        </record>

        <!-- Hide Configuration menu -->
        <record id="base.menu_translation" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),

                ])]"/>
        </record>

        <!-- Hide Configuration menu -->
        <record id="base.menu_translation_app" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),

                ])]"/>
        </record>

        <!-- Hide Configuration menu -->
        <record id="base.menu_translation_export" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),

                ])]"/>
        </record>

        <record id="base.menu_action_res_groups" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [
                    ref('base.group_system'),

                ])]"/>
        </record>

        <record id="website.menu_website_configuration" model="ir.ui.menu">
            <field name="groups_id"
                   eval="[(6,0,[
               ref('base.group_system'),
               ref('waste_management_zakheni.group_wmz_admin')
           ])]"/>
        </record>



    </data>
</odoo>


