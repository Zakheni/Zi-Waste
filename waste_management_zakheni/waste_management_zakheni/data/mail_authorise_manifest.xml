<!-- Data — Mail Authorise Manifest -->
<odoo>
    <data noupdate="1">

        <!-- Styled Onboarding Welcome Email Template -->
        <!-- Views / records -->
    <record id="mail_tmpl_service_request_authorize" model="mail.template">
            <field name="name">Authorize of Service Request/Manifest – Action Required</field>
            <field name="model_id" ref="waste_management_zakheni.model_waste_service_request"/>
            <field name="subject">Ament Required – {{object.name}}</field>
            <field name="email_to">{{object.finance_email}}</field>

            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px;">
                    <div style="max-width: 600px; margin: 0 auto; background: #ffffff;
                                border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.15);">

                        <div style="background-color: #ffffff; padding: 20px;text-align: center;">
                            <table style="border-collapse: collapse;">
                                <tr>
                                    <!-- Logo Left -->

                                    <td valign="middle" align="right"
                                        t-if="not object.company_id.uses_default_logo">
                                        <img t-attf-src="/logo.png?company={{ object.company_id.id}}"
                                             style="padding: 0px; margin: 0px; height: auto; width: 80px;"
                                             t-att-alt="object.company_id.name"/>

                                    </td>
                                    <!-- Title Right here -->

                                </tr>
                            </table>

                        </div>

                        <!--                         Body-->
                        <div style="background-color: #ffffff; padding: 20px; color: #333333; line-height: 1.6;">
                            <p>Dear Finance,
                            </p>

                            <p>A service request has been Authorised</p>

                            <ul>
                                <li>
                                    <b>Request:</b>
                                    <t t-esc="object.name"/>
                                </li>
                                <li>
                                    <b>Customer:</b>
                                    <t t-esc="object.partner_id.display_name"/>
                                </li>
                                <li>
                                    <b>Company:</b>
                                    <t t-esc="object.company_id.display_name"/>
                                </li>
                                <li>
                                    <b>Status:</b>
                                    <t t-esc="object.state"/>
                                </li>
                            </ul>


                            <p>Login for more details:</p>

                            <p>
                                <a href="https://dwmis.co.za/web/login"
                                   style="padding:10px 15px;background:#000000;color:white;text-decoration:none;">
                                    Login
                                </a>

                            </p>


                            <p>Thank you,</p>
                            <p>Manager</p>
                        </div>


                        <!-- Footer -->
                        <div style="background-color: #ffffff; color: #c1c1c1; text-align: center; padding: 10px; font-size: 12px;">

                            <p class="mb-0">
                                ©
                                <span t-esc="time.strftime('%Y')"/>
                                <span t-esc="object.company_id.display_name"/>. All rights reserved.
                            </p>
                        </div>
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo>
