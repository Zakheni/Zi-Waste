<!-- Data — Mail Invide Service Provider -->
<odoo>
    <data noupdate="1">

        <!-- Styled Onboarding Welcome Email Template -->
        <!-- Views / records -->
    <record id="mail_tmpl_service_request_service_provide_invitation" model="mail.template">
            <field name="name">Invitation of Service Provider</field>
            <field name="model_id" ref="waste_management_zakheni.model_waste_service_request"/>
            <field name="subject">Invitation of Driver Action Required – {{object.name}}</field>
            <field name="email_from">{{user.email}}</field>
            <field name="email_to">{{object.provider_email}}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px;">
                    <div style="max-width: 600px; margin: 0 auto; background: #ffffff;
                                border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.15);">

                        <div style="background-color: #ffffff; padding: 20px;text-align: center;">
                            <table style="border-collapse: collapse;">
                                <tr>
                                    <!-- Logo Left -->

                                    <td valign="middle" align="right"
                                        t-if="not object.company_id.uses_default_logo">
                                        <img t-attf-src="/logo.png?company={{object.company_id.id}}"
                                             style="padding: 0px; margin: 0px; height: auto; width: 80px;"
                                             t-att-alt="object.company_id.name"/>

                                    </td>
                                    <!-- Title Right here -->

                                </tr>
                            </table>

                        </div>

                        <!--                         Body-->
                        <div style="background-color: #ffffff; padding: 20px; color: #333333; line-height: 1.6;">
                            <p>Dear <t t-out="object.provider_id.name"></t>,
                            </p>

                            <p>
                                You are hereby invited to carry out the following service request:
                                <strong>
                                    <t t-out="object.service_requested_id.name"/>
                                </strong>
                                ,
                                to our client

                                <strong>
                                    <t t-out="object.partner_id"
                                       t-options="{
                                   'widget': 'contact',
                                   'fields': ['name', 'address', 'vat'],
                                   'no_marker': True
                               }"/>
                                </strong>
                                .
                            </p>

                            <p>
                                <strong>Service Request Reference:</strong>
                                <t t-out="object.name"></t>
                                <br/>

                                <strong>Planned Date:</strong>
                                <t t-esc="format_datetime(
                                                object.planned_date,
                                                dt_format='dd/MM/yyyy HH:mm',
                                                tz='Africa/Johannesburg'
                                             )"/>
                            </p>

                            <p>
                                Kindly review the details and ensure that your team is prepared to execute the required
                                service at the scheduled time.
                                Should you require any clarification or additional information, please feel free to
                                contact
                                us.
                            </p>

                            <p>
                                Thank you for your cooperation and commitment to service excellence.
                            </p>
                            <p>Login for more details:</p>

                            <p>
                                <a href="https://dwmis.co.za/web/login"
                                   style="padding:10px 15px;background:#004080;color:white;text-decoration:none;">
                                    Login
                                </a>

                            </p>


                            <p>Kind regards,<br/>Management Team
                            </p>
                            <!-- Footer -->
                            <div style="background-color: #ffffff; color: #c1c1c1; text-align: center; padding: 10px; font-size: 12px;">

                                <p class="mb-0">
                                    ©
                                    <span t-esc="time.strftime('%Y')"/>
                                    <span t-esc="object.company_id.display_name"/>. All rights reserved.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo>
