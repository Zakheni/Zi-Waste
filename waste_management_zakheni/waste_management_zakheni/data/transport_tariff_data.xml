    <!-- ================================================== -->
    <!-- PER BIN PER KM -->
    <!-- Formula:
         (bins × per_bin_rate)
         + (bins × km × per_km_rate)
    -->
    <!-- Example:
         2 bins × 300 = 600
         2 bins × 10 km × 5 = 100
         Total = 700
    -->
    <!-- ================================================== -->
    <record id="transport_tariff_per_bin_km_initial"
            model="waste.transport.tariff">

        <field name="name">Per Bin Per KM</field>

        <field name="company_id" ref="base.main_company"/>

        <field name="rate_type">per_bin_km</field>

        <field name="date_from">2025-01-01</field>

        <!-- NEW -->
        <field name="per_bin_rate">300</field>

        <field name="per_km_rate">5</field>

        <field name="active">True</field>

    </record>

    <!-- ================================================== -->
    <!-- PER TRIP PER KM -->
    <!-- Formula:
         (trips × per_trip_rate)
         + (trips × km × per_km_rate)
    -->
    <!-- Example:
         2 trips × 700 = 1400
         2 trips × 10 km × 10 = 200
         Total = 1600
    -->
    <!-- ================================================== -->
    <record id="transport_tariff_per_trip_per_km_initial"
            model="waste.transport.tariff">

        <field name="name">Per Trip Per KM</field>

        <field name="company_id" ref="base.main_company"/>

        <field name="rate_type">per_trip_km</field>

        <field name="date_from">2025-01-01</field>

        <!-- NEW -->
        <field name="per_trip_rate">700</field>

        <field name="per_km_rate">10</field>

        <field name="active">True</field>

    </record>

