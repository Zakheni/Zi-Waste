<!-- Data — Transport Tariff Data -->
<odoo noupdate="0">

    <!-- ================================================== -->
    <!-- FLAT RATE -->
    <!-- Formula:
         base_rate + ((bins - 1) * increment_rate)
    -->
    <!-- Example:
         1 bin  = 500
         2 bins = 700
         3 bins = 900
    -->
    <!-- ================================================== -->
    <record id="transport_tariff_flat_initial"
            model="waste.transport.tariff">

        <field name="name">Flat Rate</field>

        <field name="company_id" ref="base.main_company"/>

        <field name="rate_type">flat</field>

        <field name="date_from">2025-01-01</field>

        <field name="base_rate">500</field>

        <field name="increment_rate">200</field>

        <field name="active">True</field>

    </record>

    <!-- ================================================== -->
    <!-- PER BIN -->
    <!-- Formula:
         bins × per_bin_rate
    -->
    <!-- Example:
         2 bins × 300 = 600
    -->
    <!-- ================================================== -->
    <record id="transport_tariff_per_bin_initial"
            model="waste.transport.tariff">

        <field name="name">Per Bin</field>

        <field name="company_id" ref="base.main_company"/>

        <field name="rate_type">per_bin</field>

        <field name="date_from">2025-01-01</field>

        <field name="per_bin_rate">300</field>

        <field name="active">True</field>

    </record>

