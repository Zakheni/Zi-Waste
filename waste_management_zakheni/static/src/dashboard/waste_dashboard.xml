<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="waste_management_zakheni.WasteDashboard">
    <div class="o_waste_dashboard p-3 position-relative o_waste_scroll">

      <!-- Loading overlay -->
      <t t-if="state.loading">
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
             style="background: rgba(255,255,255,.6); z-index: 10;">
          <div class="alert alert-info m-0">Loading dashboard…</div>
        </div>
      </t>

      <!-- Header (responsive) -->
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <h2 class="m-0 flex-grow-1" style="min-width:240px;">Waste Management Dashboard</h2>

        <div class="d-flex flex-wrap gap-2 justify-content-end">
          <button class="btn btn-sm btn-outline-secondary" t-on-click="onRefresh">
            <i class="fa fa-refresh me-1"></i> Refresh
          </button>

          <button class="btn btn-sm btn-outline-success" t-on-click="printDashboard">
            <i class="fa fa-print me-1"></i> Print PDF
          </button>

          <button type="button" class="btn btn-sm btn-outline-info" t-on-click="exportDashboardXlsx">
            <i class="fa fa-file-excel-o me-1"></i> Export Excel
          </button>
        </div>
      </div>

      <!-- Filters (auto-grid responsive) -->
      <div class="card mb-3">
        <div class="card-header py-2">
          <span class="fw-semibold">Filters</span>
        </div>

        <div class="card-body py-2">
          <div class="d-grid gap-2"
               style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); align-items:end;">

            <div>
              <label class="form-label small mb-1">Date From</label>
              <input class="form-control form-control-sm" type="date" t-model="state.filters.date_from"/>
            </div>

            <div>
              <label class="form-label small mb-1">Date To</label>
              <input class="form-control form-control-sm" type="date" t-model="state.filters.date_to"/>
            </div>

            <div>
              <label class="form-label small mb-1">Company</label>
              <select class="form-select form-select-sm" t-model="state.filters.company_id">
                <option t-att-value="false">All Companies</option>
                <t t-foreach="(state.companies || [])" t-as="co" t-key="co.id">
                  <option t-att-value="co.id"><t t-esc="co.name"/></option>
                </t>
              </select>
            </div>

            <div>
              <label class="form-label small mb-1">Customer</label>
              <select class="form-select form-select-sm" t-model="state.filters.partner_id">
                <option t-att-value="false">All Customers</option>
                <t t-foreach="(state.customers || [])" t-as="c" t-key="c.id">
                  <option t-att-value="c.id"><t t-esc="c.name"/></option>
                </t>
              </select>
            </div>

            <div>
              <label class="form-label small mb-1">Manifest</label>
              <input class="form-control form-control-sm" placeholder="WSR-0001" t-model="state.filters.manifest_number"/>
            </div>

            <div>
              <label class="form-label small mb-1">Sales Order</label>
              <input class="form-control form-control-sm" placeholder="SO123" t-model="state.filters.sale_order_number"/>
            </div>

            <div>
              <label class="form-label small mb-1">Invoice</label>
              <input class="form-control form-control-sm" placeholder="INV/2025/..." t-model="state.filters.invoice_number"/>
            </div>

            <div class="d-flex gap-2 justify-content-end">
              <button class="btn btn-sm btn-outline-primary" t-on-click="onApplyFilters">
                <i class="fa fa-filter me-1"></i> Apply
              </button>
              <button class="btn btn-sm btn-outline-secondary" t-on-click="onClearFilters">
                <i class="fa fa-eraser me-1"></i> Clear
              </button>
            </div>

          </div>
        </div>
      </div>

      <!-- KPI Cards -->
      <div class="row g-3 mb-3">

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
          <div class="card h-100 o_kpi_card border-start border-4 border-primary" style="cursor:pointer"
               t-on-click="openOpenClick">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="o_kpi_icon bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;">
                <i class="fa fa-inbox"/>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted">Open Requests</div>
                <div class="h3 m-0"><t t-esc="state.kpis.open_requests"/></div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
          <div class="card h-100 o_kpi_card border-start border-4 border-info" style="cursor:pointer"
               t-on-click="openScheduledClick">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="o_kpi_icon bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;">
                <i class="fa fa-calendar"/>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted">Scheduled</div>
                <div class="h3 m-0"><t t-esc="state.kpis.scheduled_count"/></div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
          <div class="card h-100 o_kpi_card border-start border-4 border-warning" style="cursor:pointer"
               t-on-click="openInProgressClick">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="o_kpi_icon bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;">
                <i class="fa fa-truck"/>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted">In Progress</div>
                <div class="h3 m-0"><t t-esc="state.kpis.in_progress"/></div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
          <div class="card h-100 o_kpi_card border-start border-4 border-success" style="cursor:pointer"
               t-on-click="openDoneClick">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="o_kpi_icon bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;">
                <i class="fa fa-check-circle"/>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted">Authorised</div>
                <div class="h3 m-0"><t t-esc="state.kpis.done_count"/></div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
          <div class="card h-100 o_kpi_card border-start border-4 border-danger" style="cursor:pointer"
               t-on-click="openRejectedClick">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="o_kpi_icon bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;">
                <i class="fa fa-ban"/>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted">Rejected / Flagged</div>
                <div class="h3 m-0"><t t-esc="state.kpis.rejected_count"/></div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
          <div class="card h-100 o_kpi_card border-start border-4 border-dark">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="o_kpi_icon bg-dark-subtle text-dark rounded-circle d-flex align-items-center justify-content-center"
                   style="width:44px;height:44px;">
                <i class="fa fa-money"/>
              </div>
              <div class="flex-grow-1">
                <div class="text-muted">Billing (This Month)</div>
                <div class="h5 m-0">R <t t-esc="(state.kpis.billing_amount_month || 0).toFixed(2)"/></div>

                <t t-if="state.mode and state.mode.show_tanks">
                  <div class="text-muted mt-1">
                    Tank kL: <t t-esc="(state.kpis.tank_kl_month || 0).toFixed(2)"/>
                  </div>
                </t>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Helper: reusable chart card (consistent height + no jumping) -->
      <t t-set="chartBodyStyle" t-value="'min-height:320px; height:320px;'"/>

      <!-- Charts row 1 -->
      <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Requests by Status</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="statusCanvas"/>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Requests by Service</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="serviceCanvas"/>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts row 2 -->
      <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Top Customers</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="topCustomersCanvas"/>
            </div>
          </div>
        </div>

        <t t-if="state.mode and state.mode.show_tanks">
          <div class="col-12 col-lg-6">
            <div class="card h-100 d-flex flex-column">
              <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Tank kL (<t t-esc="state.filters.tank_granularity"/>)</span>
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-outline-secondary" t-on-click="onTankDay">Day</button>
                  <button class="btn btn-outline-secondary" t-on-click="onTankWeek">Week</button>
                </div>
              </div>
              <div class="card-body" t-att-style="chartBodyStyle">
                <canvas t-ref="tankCanvas"/>
              </div>
            </div>
          </div>
        </t>
      </div>

      <!-- Charts row 3 -->
      <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Customer by Service Offering</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="customerServiceCanvas"/>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Driver by Trips Traveled</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="driverTripsCanvas"/>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts row 4 -->
      <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Revenue Analysis</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="revenueCanvas"/>
            </div>
          </div>
        </div>

        <t t-if="state.mode and state.mode.show_bins">
          <div class="col-12 col-lg-6">
            <div class="card h-100 d-flex flex-column">
              <div class="card-header">Bin Report</div>
              <div class="card-body" t-att-style="chartBodyStyle">
                <canvas t-ref="binCanvas"/>
              </div>
            </div>
          </div>
        </t>
      </div>

      <!-- Revenue by Company -->
      <div class="card mb-3 h-100 d-flex flex-column">
        <div class="card-header">Revenue by Company</div>
        <div class="card-body" t-att-style="chartBodyStyle">
          <canvas t-ref="revenueCompanyCanvas"/>
        </div>
      </div>

      <!-- Bin Revenue section (only if bins enabled) -->
      <t t-if="state.mode and state.mode.show_bins">
        <div class="row g-3 mb-3">

          <div class="col-12 col-lg-6">
            <div class="card h-100 d-flex flex-column">
              <div class="card-header">Bin Revenue (Top 10)</div>
              <div class="card-body" t-att-style="chartBodyStyle">
                <canvas t-ref="binRevenueCanvas"/>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6">
            <div class="card h-100 d-flex flex-column">
              <div class="card-header">Bin Revenue Table (Top 10)</div>
              <div class="card-body p-0 flex-grow-1">
                <div class="table-responsive">
                  <table class="table table-hover m-0 align-middle">
                    <thead>
                      <tr>
                        <th class="text-nowrap">Bin</th>
                        <th class="text-end text-nowrap">Trips</th>
                        <th class="text-end text-nowrap">Lifted</th>
                        <th class="text-end text-nowrap">Dropped</th>
                        <th class="text-end text-nowrap">Revenue</th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-if="!(state.bin_revenue_table || []).length">
                        <tr><td colspan="5" class="text-muted p-3">No bin revenue found for current filter.</td></tr>
                      </t>
                      <t t-foreach="state.bin_revenue_table" t-as="r" t-key="r.key">
                        <tr style="cursor:pointer" t-on-click="() => onBinRevenueRowClick(r)">
                          <td class="text-nowrap"><t t-esc="r.bin"/></td>
                          <td class="text-end"><t t-esc="r.trips"/></td>
                          <td class="text-end"><t t-esc="r.lifted"/></td>
                          <td class="text-end"><t t-esc="r.dropped"/></td>
                          <td class="text-end text-nowrap">R <t t-esc="((r.revenue || 0) * 1).toFixed(2)"/></td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

        </div>
      </t>

      <!-- Sales Orders by Customer -->
      <div class="card mb-3 h-100 d-flex flex-column">
        <div class="card-header">Sales Order by Customer</div>
        <div class="card-body" t-att-style="chartBodyStyle">
          <canvas t-ref="soCustomerCanvas"/>
        </div>
      </div>

      <!-- Pie charts row -->
      <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Today Jobs: Driver vs Service Provider</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="assignmentPieCanvas"/>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header">Users: Internal / Portal / Inactive</div>
            <div class="card-body" t-att-style="chartBodyStyle">
              <canvas t-ref="usersPieCanvas"/>
            </div>
          </div>
        </div>
      </div>

      <!-- Summary tables row 1 -->
      <div class="row g-3 mb-3">

        <!-- Manifest summary -->
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span>Manifest Table (Summary)</span>
              <button class="btn btn-sm btn-outline-primary" t-on-click="openManifestList">View all</button>
            </div>

            <div class="card-body p-0 flex-grow-1">
              <div class="table-responsive">
                <table class="table table-hover m-0 align-middle">
                  <thead>
                    <tr>
                      <th class="text-nowrap">Manifest</th>
                      <th class="text-nowrap">Customer</th>
                      <th class="text-nowrap">Date</th>
                      <t t-if="state.mode and state.mode.show_bins">
                        <th class="text-end text-nowrap">Bin Count</th>
                      </t>
                    </tr>
                  </thead>

                  <tbody>
                    <t t-if="!(state.manifest_summary || []).length">
                      <tr>
                        <t t-if="state.mode and state.mode.show_bins">
                          <td colspan="4" class="text-muted p-3">No manifests found for current filter.</td>
                        </t>
                        <t t-else="">
                          <td colspan="3" class="text-muted p-3">No manifests found for current filter.</td>
                        </t>
                      </tr>
                    </t>

                    <t t-foreach="(state.manifest_summary || [])" t-as="m" t-key="m.id">
                      <tr style="cursor:pointer" t-on-click="() => openManifestRowClick(m)">
                        <td class="text-nowrap">
                          <t t-esc="m.name || ''"/>
                          <button type="button" class="btn btn-sm btn-outline-secondary ms-2"
                                  t-on-click.stop="() => applyManifestFilterClick(m)">
                            Filter
                          </button>
                        </td>
                        <td><t t-esc="m.partner || (m.partner_id ? m.partner_id[1] : '')"/></td>
                        <td class="text-nowrap"><t t-esc="m.date || m.service_request_date || ''"/></td>
                        <t t-if="state.mode and state.mode.show_bins">
                          <td class="text-end"><t t-esc="m.bin_count || 0"/></td>
                        </t>
                      </tr>
                    </t>

                  </tbody>
                </table>
              </div>
            </div>

          </div>
        </div>

        <!-- Sales Order ↔ Invoice totals -->
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span>Sales Order ↔ Invoice (Totals)</span>
              <button class="btn btn-sm btn-outline-primary" t-on-click="openInvoiceTotalsList">View all</button>
            </div>

            <div class="card-body p-0 flex-grow-1">
              <div class="table-responsive">
                <table class="table table-hover m-0 align-middle">
                  <thead>
                    <tr>
                      <th class="text-nowrap">Sales Order</th>
                      <th class="text-nowrap">Invoice</th>
                      <th class="text-end text-nowrap">Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-if="!(state.so_invoice_totals || []).length">
                      <tr><td colspan="3" class="text-muted p-3">No invoice totals found for current filter.</td></tr>
                    </t>
                    <t t-foreach="(state.so_invoice_totals || [])" t-as="x" t-key="x.key || x.id">
                      <tr style="cursor:pointer" t-on-click="() => openInvoiceTotalsRowClick(x)">
                        <td class="text-nowrap"><t t-esc="x.sale_order || (x.sale_order_id ? x.sale_order_id[1] : '')"/></td>
                        <td class="text-nowrap"><t t-esc="x.invoice || (x.invoice_id ? x.invoice_id[1] : '')"/></td>
                        <td class="text-end text-nowrap">R <t t-esc="((x.total || x.amount_total || 0) * 1).toFixed(2)"/></td>
                      </tr>
                    </t>
                  </tbody>
                </table>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Summary tables row 2 -->
      <div class="row g-3 mb-3">

        <!-- Bin Report (Dropped) -->
        <t t-if="state.mode and state.mode.show_bins">
          <div class="col-12 col-lg-6">
            <div class="card h-100 d-flex flex-column">
              <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Bin Report (Dropped)</span>
                <button class="btn btn-sm btn-outline-primary" t-on-click="openBinReportList">View all</button>
              </div>

              <div class="card-body p-0 flex-grow-1">
                <div class="table-responsive">
                  <table class="table table-hover m-0 align-middle">
                    <thead>
                      <tr>
                        <th class="text-nowrap">Manifest</th>
                        <th class="text-nowrap">Bin</th>
                        <th class="text-nowrap">Pickup Point</th>
                        <th class="text-nowrap">Date</th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-if="!(state.bin_report || []).length">
                        <tr><td colspan="4" class="text-muted p-3">No bin drops found for current filter.</td></tr>
                      </t>
                      <t t-foreach="(state.bin_report || [])" t-as="b" t-key="b.key || b.id">
                        <tr style="cursor:pointer" t-on-click="() => openBinReportRowClick(b)">
                          <td class="text-nowrap"><t t-esc="b.manifest || (b.request_id ? b.request_id[1] : '')"/></td>
                          <td class="text-nowrap"><t t-esc="b.bin || (b.container_id ? b.container_id[1] : '')"/></td>
                          <td><t t-esc="b.dropoff_point || b.pickup_point || (b.pickup_point_id ? b.pickup_point_id[1] : '')"/></td>
                          <td class="text-nowrap"><t t-esc="b.date || ''"/></td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>
              </div>

            </div>
          </div>
        </t>

        <!-- Today schedule -->
        <div class="col-12 col-lg-6">
          <div class="card h-100 d-flex flex-column">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span>Today’s Schedule</span>
              <button class="btn btn-sm btn-outline-primary" t-on-click="openTodayListClick">Open list</button>
            </div>

            <div class="card-body p-0 flex-grow-1">
              <div class="table-responsive">
                <table class="table table-hover m-0 align-middle">
                  <thead>
                    <tr>
                      <th class="text-nowrap">Request</th>
                      <th class="text-nowrap">Customer</th>
                      <th class="text-nowrap">Planned Date</th>
                      <th class="text-nowrap">Type</th>
                      <th class="text-nowrap">Provider / Truck</th>
                      <th class="text-nowrap">Driver</th>
                      <th class="text-nowrap">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-if="!(state.todays || []).length">
                      <tr><td colspan="7" class="text-muted p-3">No jobs scheduled today.</td></tr>
                    </t>

                    <t t-foreach="(state.todays || [])" t-as="r" t-key="r.id">
                      <tr style="cursor:pointer" t-on-click="() => openTodayRowClick(r)">
                        <td class="text-nowrap"><t t-esc="r.name"/></td>
                        <td><t t-esc="r.partner_id ? r.partner_id[1] : ''"/></td>
                        <td class="text-nowrap"><t t-esc="r.planned_date || r.scheduled_date || r.schedule_date || r.dispatch_date || ''"/></td>
                        <td class="text-nowrap">
                          <t t-if="r.is_service_provider">Service Provider</t>
                          <t t-else="">Driver</t>
                        </td>
                        <td>
                          <t t-if="r.is_service_provider">
                            <t t-esc="r.provider_id ? r.provider_id[1] : ''"/>
                          </t>
                          <t t-else="">
                            <t t-esc="r.vehicle_id ? r.vehicle_id[1] : ''"/>
                          </t>
                        </td>
                        <td><t t-esc="r.driver_id ? r.driver_id[1] : ''"/></td>
                        <td class="text-nowrap"><t t-esc="r.state"/></td>
                      </tr>
                    </t>

                  </tbody>
                </table>
              </div>
            </div>

          </div>
        </div>

      </div>

