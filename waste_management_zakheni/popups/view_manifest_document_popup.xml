<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manifest Document Popup -->
    <record id="view_manifest_document_popup" model="ir.ui.view">
        <field name="name">waste.service.request.manifest.document.popup</field>
        <field name="model">waste.service.request</field>
        <field name="arch" type="xml">
            <form string="Manifest Document" create="false" edit="false">
                <sheet>
                    <field name="latest_worksheet_manifest_document" widget="pdf_viewer" filename="latest_worksheet_manifest_document_filename"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
