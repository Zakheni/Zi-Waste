<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admin: own records OR from portal -->
    <record id="wmz_rule_manifest_admin" model="ir.rule">
        <field name="name">Manifest: Admin</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin'))]"/>
        <field name="domain_force">
            ['|',
            ('create_uid', '=', user.id),
            ('from_portal', '=', True)
            ]
        </field>
    </record>


    <!-- Admin Clerk -->
    <record id="wmz_rule_manifest_admin_clerk" model="ir.rule">
        <field name="name">Manifest: Admin Clerk (by company)</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin_clerk'))]"/>

        <field name="domain_force">
            [
            ('from_portal', '=', True),
            ('company_id', '=', user.company_id.id)
            ]
        </field>

    </record>

    <record id="wmz_rule_admin_clerk_own_records" model="ir.rule">
        <field name="name">Manifest: Admin Clerk - Own records</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin_clerk'))]"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            [
            ('create_uid', '=', user.id)
            ]
        </field>
    </record>


    <!-- Manager: own records OR from portal -->
    <!-- Manager: own-company records in selected states (portal + internal) -->
    <record id="wmz_rule_manifest_manager" model="ir.rule">
        <field name="name">Manifest: Manager (company + delivered/done/cancelled)</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_manager'))]"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            [
            ('company_id', '=', user.company_id.id),
            ('state', 'in', ['service_delivered', 'done', 'cancelled'])
            ]
        </field>
    </record>


