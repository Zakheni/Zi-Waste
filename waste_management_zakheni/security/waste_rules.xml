      <!-- Admin Clerk -->
    <record id="wmz_rule_manifest_admin_clerk" model="ir.rule">
        <field name="name">Manifest: Admin Clerk (by company)</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin_clerk'))]"/>
        <field name="domain_force">
            ['|',
            ('create_uid', '=', user.id),
            ('from_portal', '=', True)
            ]
        </field>
    </record>



    <!-- Manager: own records OR from portal -->
    <record id="wmz_rule_manifest_manager" model="ir.rule">
        <field name="name">Manifest: Manager</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_manager'))]"/>
        <field name="domain_force">
            ['|',
            ('create_uid', '=', user.id),
            ('from_portal', '=', True)
            ]
        </field>
    </record>

    <!-- Finance: done OR own OR from portal -->
    <record id="wmz_rule_manifest_finance" model="ir.rule">
        <field name="name">Manifest: Finance</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_finance'))]"/>
        <field name="domain_force">
            ['|', '|',
            ('state', '=', 'done'),
            ('create_uid', '=', user.id),
            ('from_portal', '=', True)
            ]
        </field>
    </record>

    <!-- Driver: state in X OR from portal -->
    <record id="wmz_rule_manifest_driver" model="ir.rule">
        <field name="name">Manifest: Driver</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_driver'))]"/>
        <field name="domain_force">
            ['|',
            ('state', 'in', ['scheduled', 'dispatched', 'service_delivered']),
            ('from_portal', '=', True)
            ]
        </field>
    </record>
</odoo>