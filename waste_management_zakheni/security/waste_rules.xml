<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admin: own records OR from portal -->
    <record id="wmz_rule_manifest_admin" model="ir.rule">
        <field name="name">Manifest: Admin</field>
        <field name="model_id" ref="model_waste_service_request"/>
        <field name="groups" eval="[(4, ref('waste_management_zakheni.group_wmz_admin'))]"/>
        <field name="domain_force">
            ['|',
            ('create_uid', '=', user.id),
            ('from_portal', '=', True)
            ]
        </field>
    </record>

