<odoo>
    <record id="view_driver_signature_form" model="ir.ui.view">
        <field name="name">driver.signature.form</field>
        <field name="model">driver.signature</field>
        <field name="arch" type="xml">
            <form string="Enter Signature">
                <group>
<!--                    <field name="network_admin_comment"/>-->
                    <field name="driver_signature" widget="signature"/>
                    <field name="user_id" invisible="1"/>
                </group>
                <group>
                    <footer>
                        <button name="action_enter_signature"
                                string="Submit"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>

                </group>
            </form>
        </field>
    </record>
</odoo>
