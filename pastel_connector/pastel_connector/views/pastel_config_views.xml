<?xml version="1.0" encoding="utf-8"?>

<!--
    Module: pastel_connector
    File: pastel_config_views.xml
    Description: Pastel connector settings tree/form views and action.
-->
<odoo>
    <!-- View/action record: View pastel connector setting tree -->
    <record id="view_pastel_connector_setting_tree" model="ir.ui.view">
        <field name="name">pastel.connector.setting.tree</field>
        <field name="model">pastel.connector.setting</field>
        <field name="arch" type="xml">
            <tree string="Pastel Connector">
                <field name="name" readonly="1"/>
                <field name="pastel_api_base" placeholder="http://WINDOWS-IP:8787"/>
                <field name="pastel_api_key" password="True"/>
                <field name="enable_push_to_sage"/>
            </tree>
        </field>
    </record>

    <!-- View/action record: View pastel connector setting form -->

    <record id="view_pastel_connector_setting_form" model="ir.ui.view">
        <field name="name">pastel.connector.setting.form</field>
        <field name="model">pastel.connector.setting</field>
        <field name="arch" type="xml">
            <form string="Pastel Connector">
                <header>
                    <button string="Test Connection" type="object" name="action_test_connection"
                            class="oe_highlight"/>
                    <!--                        <button string="Import All Now" type="object" name="action_import_all_now" class="btn-primary"/>-->
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                    <group>
                        <field name="pastel_api_base" placeholder="http://WINDOWS-IP:8787"/>
                        <field name="pastel_api_key" password="True"/>
                        <field name="enable_push_to_sage" readonly="1" invisible="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- View/action record: Action pastel connector setting -->

    <record id="action_pastel_connector_setting" model="ir.actions.act_window">
        <field name="name">Pastel Connector</field>
        <field name="res_model">pastel.connector.setting</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="context">{'default_name': 'Pastel Connector Configuration'}</field>
    </record>
</odoo>
