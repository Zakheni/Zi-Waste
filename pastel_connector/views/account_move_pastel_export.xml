<odoo>

   <record id="view_move_form_pastel_export" model="ir.ui.view">
    <field name="name">account.move.form.pastel.export</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

        <!-- Make field available in view -->
        <xpath expr="//sheet" position="inside">
            <field name="export_state" invisible="1"/>
        </xpath>

        <!-- Header button -->
        <xpath expr="//header" position="inside">

            <button name="action_export_to_sage"
                    string="Export to Sage"
                    type="object"
                    class="oe_highlight"
                    groups="waste_management_zakheni.group_wmz_admin,
                            waste_management_zakheni.group_wmz_finance"
                    invisible="payment_state in ('paid','partial') or state != 'posted' or hide_payment_buttons"/>
        </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="hide_payment_buttons" invisible="1"/>
                                <field name="is_paid_via_batch" invisible="1"/>

            </xpath>
    </field>
</record>



    <record id="view_out_invoice_tree_exported" model="ir.ui.view">
        <field name="name">account.move.tree.exported</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_state']" position="after">

                <field name="export_state"
                       string="Export Status"
                       widget="badge"
                       decoration-info="export_state == 'exported'"
                       />

            </xpath>

        </field>
    </record>

</odoo>



